# Skopiuj ten plik do .env i wstaw prawdziwe ID formularza z formspree.io (Settings -> Endpoint).
# To tylko identyfikator (np. "xzznnkyq"), nie cały URL.
PUBLIC_FORMSPREE_ID=

# Cloudflare Web Analytics - opcjonalny
# PUBLIC_CF_BEACON_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# R2 Cloudflare - dane dla skryptu sync-images (nie PUBLIC_ - tylko dla Node)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

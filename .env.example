# Skopiuj ten plik do .env i wstaw prawdziwe ID formularza z formspree.io (Settings -> Endpoint).
# To tylko identyfikator (np. "xzznnkyq"), nie cały URL.
PUBLIC_FORMSPREE_ID=

# Umami Analytics (self-hosted)
# PUBLIC_UMAMI_WEBSITE_ID=xxxxx-xxxxx-xxxxx-xxxxx
# PUBLIC_UMAMI_SCRIPT_URL=https://twoja-domena-umami.com/script.js
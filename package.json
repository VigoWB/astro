{
  "name": "foto-vigolab",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "sync-images": "node --env-file=.env scripts/sync-images.mjs",
    "build:testy": "node scripts/build-testowy.mjs",
    "test": "npm run check && npm run test:jednostkowe && npm run test:integracyjne && npm run test:e2e",
    "test:jednostkowe": "vitest run --project jednostkowe",
    "test:integracyjne": "vitest run --project integracyjne",
    "test:e2e": "npm run build:testy && playwright test",
    "preview": "astro preview --port 4322",
    "preview:testy": "astro preview --port 4323 --outDir ./dist-testy --ignore-lock",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "aws4fetch": "^1.0.20",
    "exifr": "^7.1.3",
    "piexifjs": "^1.0.6",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

---
// ContactForm.astro — formularz kontaktowy wysyłany do Formspree metodą AJAX (fetch),
// bez przeładowania strony. ID formularza wczytywane jest z .env (PUBLIC_FORMSPREE_ID),
// więc nic nie jest zaszyte na sztywno w kodzie — zob. .env.example.
//
// Atrybuty required/type/minlength zostają w markupie jako zabezpieczenie HTML5 i fallback
// na wypadek wyłączonego JS-a (wtedy formularz i tak leci normalnym POST-em do Formspree).
// Gdy JS jest dostępny, przejmuje walidację i pokazuje własne, polskie komunikaty błędów
// zamiast natywnych dymków przeglądarki (które bywają po angielsku).
//
// Cloudflare Turnstile (ochrona przed botami) włącza się automatycznie, gdy w .env jest
// ustawione PUBLIC_TURNSTILE_SITE_KEY — bez tej zmiennej widget po prostu się nie pokazuje,
// a formularz działa tak jak wcześniej. Skrypt Turnstile ładuje się w <head> przez prop
// `turnstile` przekazany do <Layout> na stronie /kontakt. Weryfikacja tokenu po stronie
// serwera dzieje się w Formspree (Secret Key ustawiony w ich dashboardzie, nie w tym repo).

import siteConfig from "../data/siteConfig.json";

const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID ?? "";
const akcjaFormularza = formspreeId ? `https://formspree.io/f/${formspreeId}` : undefined;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";

// Adres do komunikatów błędów („napisz na …") — ten sam, co w danych strukturalnych (siteConfig.json).
const adresMailowy = siteConfig.person.email;
---

<form
	id="formularz-kontaktowy"
	class="flex max-w-xl flex-col gap-6"
	action={akcjaFormularza}
	method="POST"
	data-formspree-id={formspreeId}
	data-email={adresMailowy}
	data-turnstile-enabled={turnstileSiteKey ? "true" : "false"}
	data-testid="contact-form"
>
	<div class="flex flex-col gap-1.5">
		<label for="kontakt-name" class="text-sm font-medium text-ink">Imię i nazwisko</label>
		<input
			type="text"
			id="kontakt-name"
			name="name"
			required
			minlength="2"
			autocomplete="name"
			aria-describedby="kontakt-name-blad"
			class="w-full border border-muted bg-paper px-3 py-2.5 text-ink transition-colors focus:outline-hidden focus:border-accent focus:ring-2 focus:ring-accent aria-invalid:border-error"
			data-testid="contact-name"
		/>
		<p id="kontakt-name-blad" class="min-h-5 text-sm text-error" aria-live="polite"></p>
	</div>

	<div class="flex flex-col gap-1.5">
		<label for="kontakt-email" class="text-sm font-medium text-ink">Email</label>
		<input
			type="email"
			id="kontakt-email"
			name="email"
			required
			autocomplete="email"
			aria-describedby="kontakt-email-blad"
			class="w-full border border-muted bg-paper px-3 py-2.5 text-ink transition-colors focus:outline-hidden focus:border-accent focus:ring-2 focus:ring-accent aria-invalid:border-error"
			data-testid="contact-email"
		/>
		<p id="kontakt-email-blad" class="min-h-5 text-sm text-error" aria-live="polite"></p>
	</div>

	<div class="flex flex-col gap-1.5">
		<label for="kontakt-message" class="text-sm font-medium text-ink">Wiadomość</label>
		<textarea
			id="kontakt-message"
			name="message"
			required
			minlength="10"
			rows="6"
			aria-describedby="kontakt-message-blad"
			class="w-full resize-y border border-muted bg-paper px-3 py-2.5 text-ink transition-colors focus:outline-hidden focus:border-accent focus:ring-2 focus:ring-accent aria-invalid:border-error"
			data-testid="contact-message"
		></textarea>
		<p id="kontakt-message-blad" class="min-h-5 text-sm text-error" aria-live="polite"></p>
	</div>

	<!-- Honeypot antyspamowy Formspree: pole ma zostać puste. Ukryte przed ludźmi i czytnikami ekranu,
	     ale prosty bot skanujący HTML często wypełni je automatycznie i zdradzi się w ten sposób. -->
	<input
		type="text"
		name="_gotcha"
		tabindex="-1"
		autocomplete="off"
		class="hidden"
		aria-hidden="true"
	/>

	<!-- Cloudflare Turnstile — nieinwazyjne sprawdzenie "czy to człowiek". Renderuje się tylko,
	     gdy PUBLIC_TURNSTILE_SITE_KEY jest ustawione (zob. .env.example). Widget sam wstrzykuje
	     ukryte pole <input name="cf-turnstile-response">, które trafia do FormData razem
	     z resztą formularza, bo siedzi w środku <form>. -->
	{turnstileSiteKey && (
		<div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-testid="contact-turnstile"></div>
	)}

	<div class="flex flex-col items-start gap-3">
		<button
			type="submit"
			id="przycisk-wyslij"
			class="bg-accent px-6 py-3 font-semibold text-paper transition-colors hover:bg-ink hover:text-paper disabled:pointer-events-none disabled:opacity-50"
			data-testid="contact-submit"
		>
			Wyślij wiadomość
		</button>
		<p id="status-formularza" class="text-sm" role="status" aria-live="polite" data-testid="contact-status"></p>
	</div>
</form>

<script>
	// Szuka elementu po id. Gdy go nie ma, od razu rzuca czytelny błąd
	// (zamiast niezrozumiałego „Cannot read properties of null").
	function znajdz<T extends HTMLElement = HTMLElement>(id: string): T {
		const element = document.getElementById(id);
		if (!element) throw new Error(`ContactForm: brak elementu #${id}`);
		return element as T;
	}

	const formularz = znajdz<HTMLFormElement>("formularz-kontaktowy");
	const przycisk = znajdz<HTMLButtonElement>("przycisk-wyslij");
	const tekstPrzycisku = przycisk.textContent ?? "Wyślij wiadomość";
	const statusFormularza = znajdz("status-formularza");

	// ID Formspree, flaga Turnstile i adres e-mail wracają do nas z serwera (Astro frontmatter)
	// przez atrybuty data-*, bo zwykła stała z frontmatteru nie jest widoczna w tym skrypcie
	// (inne środowisko wykonania).
	const formspreeId = formularz.dataset.formspreeId ?? "";
	const turnstileWlaczony = formularz.dataset.turnstileEnabled === "true";
	const adresMailowy = formularz.dataset.email ?? "";

	// Dopisek do komunikatów błędów — odwiedzający musi wiedzieć, dokąd napisać, gdy formularz zawiedzie.
	const wskazowkaMail = adresMailowy ? `napisz na ${adresMailowy}` : "napisz do mnie bezpośrednio";

	// JS przejmuje walidację od przeglądarki — patrz komentarz w markupie wyżej.
	formularz.noValidate = true;

	type KluczPola = "name" | "email" | "message";

	const pola: Record<KluczPola, { input: HTMLInputElement | HTMLTextAreaElement; blad: HTMLElement }> = {
		name: {
			input: znajdz<HTMLInputElement>("kontakt-name"),
			blad: znajdz("kontakt-name-blad"),
		},
		email: {
			input: znajdz<HTMLInputElement>("kontakt-email"),
			blad: znajdz("kontakt-email-blad"),
		},
		message: {
			input: znajdz<HTMLTextAreaElement>("kontakt-message"),
			blad: znajdz("kontakt-message-blad"),
		},
	};

	// Prosty, ale skuteczny regex na email — dodatkowa warstwa poza type="email" z HTML5.
	const regexEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

	const komunikatPoprawPola = "Popraw zaznaczone pola powyżej.";

	function walidujPole(klucz: KluczPola): { ok: boolean; komunikat?: string } {
		const wartosc = pola[klucz].input.value.trim();

		if (klucz === "name") {
			if (!wartosc) return { ok: false, komunikat: "Podaj imię i nazwisko." };
			if (wartosc.length < 2) return { ok: false, komunikat: "To imię wygląda na zbyt krótkie." };
		}

		if (klucz === "email") {
			if (!wartosc) return { ok: false, komunikat: "Podaj adres email." };
			if (!regexEmail.test(wartosc)) return { ok: false, komunikat: "Ten adres email wygląda na niepoprawny." };
		}

		if (klucz === "message") {
			if (!wartosc) return { ok: false, komunikat: "Napisz treść wiadomości." };
			if (wartosc.length < 10) return { ok: false, komunikat: "Wiadomość jest zbyt krótka (min. 10 znaków)." };
		}

		return { ok: true };
	}

	// Czerwoną ramkę pola rysuje sam CSS (klasa aria-invalid:border-error w markupie),
	// więc tu wystarczy ustawić atrybut aria-invalid i tekst błędu.
	function pokazBlad(klucz: KluczPola, komunikat: string) {
		const { input, blad } = pola[klucz];
		blad.textContent = komunikat;
		input.setAttribute("aria-invalid", "true");
	}

	function ukryjBlad(klucz: KluczPola) {
		const { input, blad } = pola[klucz];
		blad.textContent = "";
		input.removeAttribute("aria-invalid");
	}

	// pokazujNoweBledy=true przy blur/submit (informujemy od razu o nowym błędzie).
	// pokazujNoweBledy=false przy input (nie strasz błędem w trakcie pisania —
	// ale jeśli błąd już był pokazany, aktualizuj go na bieżąco, aż zniknie).
	function odswiezPole(klucz: KluczPola, pokazujNoweBledy: boolean): boolean {
		const wynik = walidujPole(klucz);
		const mialJuzBlad = pola[klucz].blad.textContent !== "";

		if (!wynik.ok && (pokazujNoweBledy || mialJuzBlad)) {
			pokazBlad(klucz, wynik.komunikat!);
		} else if (wynik.ok) {
			ukryjBlad(klucz);
		}

		// Gdy żadne pole nie ma już błędu, zdejmij czerwone „Popraw zaznaczone pola".
		if (
			statusFormularza.textContent === komunikatPoprawPola &&
			!Object.values(pola).some(({ blad }) => blad.textContent !== "")
		) {
			ustawStatus("", "");
		}

		return wynik.ok;
	}

	(Object.keys(pola) as KluczPola[]).forEach((klucz) => {
		pola[klucz].input.addEventListener("blur", () => odswiezPole(klucz, true));
		pola[klucz].input.addEventListener("input", () => odswiezPole(klucz, false));
	});

	// Sprawdza wszystkie pola; fokus trafia do pierwszego błędnego.
	function walidujCalyFormularz(): boolean {
		let pierwszyBledny: KluczPola | null = null;
		for (const klucz of Object.keys(pola) as KluczPola[]) {
			if (!odswiezPole(klucz, true) && !pierwszyBledny) pierwszyBledny = klucz;
		}
		if (pierwszyBledny) pola[pierwszyBledny].input.focus();
		return !pierwszyBledny;
	}

	function ustawStatus(tekst: string, rodzaj: "wysylanie" | "sukces" | "blad" | "") {
		statusFormularza.textContent = tekst;
		statusFormularza.classList.remove("text-muted", "text-error", "text-success");
		if (rodzaj === "wysylanie") statusFormularza.classList.add("text-muted");
		if (rodzaj === "sukces") statusFormularza.classList.add("text-success");
		if (rodzaj === "blad") statusFormularza.classList.add("text-error");
	}

	// Token Turnstile trafia asynchronicznie do ukrytego pola <input name="cf-turnstile-response">
	// wewnątrz .cf-turnstile, gdy odwiedzający "przejdzie" weryfikację (zwykle ułamek sekundy,
	// bez żadnej interakcji przy trybie Managed).
	function tokenTurnstileGotowy(): boolean {
		if (!turnstileWlaczony) return true;
		const pole = formularz.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]');
		return Boolean(pole?.value);
	}

	type TurnstileApi = { reset: (kontener?: string | HTMLElement) => void };
	const pobierzTurnstile = () => (window as unknown as { turnstile?: TurnstileApi }).turnstile;

	// Token Turnstile działa tylko raz — po każdej próbie wysyłki prosimy widżet o nowy.
	function odnowTurnstile() {
		if (!turnstileWlaczony) return;
		const pole = formularz.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]');
		if (pole) pole.value = "";
		pobierzTurnstile()?.reset(formularz.querySelector<HTMLElement>(".cf-turnstile") ?? undefined);
	}

	// Komunikat po polsku zamiast surowego tekstu z Formspree (który bywa po angielsku).
	function komunikatBleduHttp(status: number): string {
		if (status === 429) return "Za dużo prób wysyłki z tego łącza. Odczekaj chwilę i spróbuj ponownie.";
		if (status >= 500) return `Usługa formularza chwilowo nie działa. Spróbuj za kilka minut albo ${wskazowkaMail}.`;
		return `Nie udało się wysłać wiadomości. Sprawdź dane i spróbuj jeszcze raz albo ${wskazowkaMail}.`;
	}

	formularz.addEventListener("submit", async (e) => {
		e.preventDefault();

		if (!walidujCalyFormularz()) {
			ustawStatus(komunikatPoprawPola, "blad");
			return;
		}

		if (!formspreeId) {
			ustawStatus(`Formularz chwilowo nie działa — ${wskazowkaMail}.`, "blad");
			console.warn("ContactForm: uzupełnij PUBLIC_FORMSPREE_ID w pliku .env (zob. .env.example).");
			return;
		}

		if (!tokenTurnstileGotowy()) {
			ustawStatus(
				pobierzTurnstile()
					? "Trwa jeszcze weryfikacja, że nie jesteś robotem. Odczekaj chwilę i wyślij ponownie."
					: `Weryfikacja antyspamowa jeszcze się nie wczytała — poczekaj chwilę. Jeśli to się powtarza, wyłącz blokadę reklam dla tej strony i odśwież ją albo ${wskazowkaMail}.`,
				"blad",
			);
			console.warn("ContactForm: brak tokenu Turnstile (widget niegotowy albo niewczytany).");
			return;
		}

		przycisk.disabled = true;
		przycisk.textContent = "Wysyłanie...";
		ustawStatus("Wysyłanie...", "wysylanie");

		try {
			const dane = new FormData(formularz);
			const odpowiedz = await fetch(`https://formspree.io/f/${formspreeId}`, {
				method: "POST",
				body: dane,
				headers: { Accept: "application/json" },
				signal: AbortSignal.timeout(15000),
			});

			if (odpowiedz.ok) {
				formularz.reset();
				(Object.keys(pola) as KluczPola[]).forEach((klucz) => ukryjBlad(klucz));
				ustawStatus("Dziękuję! Wiadomość została wysłana — odezwę się najszybciej, jak się da.", "sukces");
			} else {
				const wynik = await odpowiedz.json().catch(() => null);
				console.warn("ContactForm: Formspree odrzucił wysyłkę", odpowiedz.status, wynik);
				ustawStatus(komunikatBleduHttp(odpowiedz.status), "blad");
			}
		} catch (blad) {
			const przekroczonoCzas = blad instanceof DOMException && blad.name === "TimeoutError";
			ustawStatus(
				przekroczonoCzas
					? `Wysyłka trwa zbyt długo. Spróbuj ponownie za chwilę albo ${wskazowkaMail}.`
					: "Brak połączenia z internetem. Sprawdź sieć i spróbuj ponownie.",
				"blad",
			);
		} finally {
			przycisk.disabled = false;
			przycisk.textContent = tekstPrzycisku;
			odnowTurnstile();
		}
	});
</script>

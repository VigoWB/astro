---
import Container from "../components/ui/Container.astro";
import { navLinks } from "../data/nav.ts";

const rok = new Date().getFullYear();

// Wygląd linków w stopce (kolor, najechanie, obwódka przy Tab) — tylko klasami Tailwinda,
// tak samo jak w Header.astro. Nie dublujemy tego w <style>: zwykły CSS z <style>
// wygrywa z klasami Tailwinda i po cichu je wyłącza.
const klasyLinku =
  "text-base font-semibold text-ink hover:text-accent transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper";
---

<footer class="footer" role="contentinfo">
  <Container>
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="copyright">© {rok} Wiktor</p>
      </div>

      <nav class="footer-nav" aria-label="Nawigacja">
        <ul class="footer-nav-list">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class={klasyLinku}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer-social">
        <a href="mailto:BrzezinskiWiktor@outlook.com" class={klasyLinku}>Kontakt</a>
      </div>
    </div>
  </Container>
</footer>

<style>
  .footer {
    padding: 1.5rem 0;  /* py-6 */
    border-top: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .footer-grid {
    display: grid;
    gap: 1.5rem;
    text-align: center;
    grid-template-columns: 1fr;
  }

  .footer-brand .copyright {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .footer-nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .footer-social::before {
    content: "";
    width: 100%;
    border-top: 1px solid var(--color-line);
    margin-bottom: 0.75rem;
  }

  /* Tablet: 2 columns - brand left, nav+social right */
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: auto 1fr;
      text-align: left;
    }

    .footer-brand {
      grid-column: 1;
      grid-row: 1;
    }

    .footer-nav {
      grid-column: 2;
    }

    .footer-social {
      grid-column: 2;
    }

    .footer-nav-list,
    .footer-social {
      justify-content: flex-start;
    }

    .footer-social::before {
      display: block;
      width: 100%;
      margin-top: 1rem;
    }
  }

  /* Desktop: 3 columns */
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      justify-items: start;
    }

    .footer-brand {
      grid-column: 1;
    }

    .footer-nav {
      grid-column: 2;
      justify-self: center;
    }

    .footer-social {
      grid-column: 3;
      justify-self: end;
    }

    .footer-nav-list {
      justify-content: center;
    }

    .footer-social {
      justify-content: flex-end;
    }

    .footer-social::before {
      display: none;
    }
  } 
</style>
---
import Container from "../components/ui/Container.astro";
import { navLinks } from "../data/nav.ts";

const rok = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <Container>
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="copyright">© {rok} Wiktor</p>
      </div>

      <nav class="footer-nav" aria-label="Nawigacja">
        <ul class="footer-nav-list">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer-social">
        <a href="https://www.instagram.com/" target="_blank" rel="noopener" class="hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper">Instagram</a>
        <a href="mailto:BrzezinskiWiktor@outlook.com" class="hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper">Kontakt</a>
      </div>
    </div>
  </Container>
</footer>

<style>
  .footer {
    padding: 1.5rem 0;  /* py-6 */
    border-top: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .footer-grid {
    display: grid;
    gap: 1.5rem;
    text-align: center;
    grid-template-columns: 1fr;
  }

  .footer-brand .copyright {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .footer-nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }

  .footer-social::before {
    content: "";
    width: 100%;
    border-top: 1px solid var(--color-line);
    margin-bottom: 0.75rem;
  }

  .footer-nav-list a,
  .footer-social a {
    color: var(--color-ink);
    transition: color 0.2s;
    font-size: 1rem;
    font-weight: 600;
  }

  .footer-nav-list a:hover,
  .footer-social a:hover {
    color: var(--color-accent);
  }

  .footer-nav-list a:focus-visible,
  .footer-social a:focus-visible {
    outline: none;
    ring: 2px solid var(--color-accent);
    ring-offset: 2px;
    ring-offset-color: var(--color-paper);
  }

  /* Tablet: 2 columns - brand left, nav+social right */
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: auto 1fr;
      text-align: left;
    }

    .footer-brand {
      grid-column: 1;
      grid-row: 1;
    }

    .footer-nav {
      grid-column: 2;
    }

    .footer-social {
      grid-column: 2;
    }

    .footer-nav-list,
    .footer-social {
      justify-content: flex-start;
    }

    .footer-social::before {
      display: block;
      width: 100%;
      margin-top: 1rem;
    }
  }

  /* Desktop: 3 columns */
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      justify-items: start;
    }

    .footer-brand {
      grid-column: 1;
    }

    .footer-nav {
      grid-column: 2;
      justify-self: center;
    }

    .footer-social {
      grid-column: 3;
      justify-self: end;
    }

    .footer-nav-list {
      justify-content: center;
    }

    .footer-social {
      justify-content: flex-end;
    }

    .footer-social::before {
      display: none;
    }
  }

  /* Accessibility focus styles */
  .footer-nav-list a:focus-visible,
  .footer-social a:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--color-accent), 0 0 0 4px var(--color-paper);
    border-radius: 2px;
  }
</style>
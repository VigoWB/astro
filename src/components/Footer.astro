---
import Container from "../components/ui/Container.astro";
import { navLinks } from "../data/nav.ts";

const rok = new Date().getFullYear();
---

<footer class="h-15 flex items-center border-t border-line bg-paper text-ink text-xl font-semibold">
    <Container>
        <div class="flex flex-row items-center justify-between w-full">
            <div class="copyright">© {rok} Wiktor</div>
            <div class="links">
                <ul class="flex flex-row gap-4">
                    {navLinks.map((link) => (
                        <li>
                            <a href={link.href} class="hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper">
                                {link.label}
                            </a>
                        </li>
                    ))}
                    <li><a href="https://www.instagram.com/mabro_grawer/" target="_blank" rel="noopener" class="hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper">Instagram</a></li>
                    <li><a href="mailto:BrzezinskiWiktor@outlook.com" class="hover:text-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper">Kontakt</a></li>
                </ul>
            </div>
        </div>
    </Container>
</footer>
---
import Container from "../components/ui/Container.astro";
import { navLinks } from "../data/nav.ts";

const rok = new Date().getFullYear();

// Wygląd linków w stopce (kolor, najechanie, obwódka przy Tab) — tylko klasami Tailwinda,
// tak samo jak w Header.astro. Nie dublujemy tego w <style>: zwykły CSS z <style>
// wygrywa z klasami Tailwinda i po cichu je wyłącza.
const klasyLinku =
  "text-base font-semibold text-ink hover:text-accent transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper";

// Link do polityki prywatności — celowo mniejszy i osobno od głównej
// nawigacji (navLinks), która jest współdzielona z Header.astro. To link
// prawny/informacyjny, nie część głównego menu.
const klasyLinkuPrawnego =
  "text-sm text-muted hover:text-accent transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper";
---

<footer class="footer" role="contentinfo">
  <Container>
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="copyright">© {rok} Wiktor</p>
      </div>

      <nav class="footer-nav" aria-label="Nawigacja">
        <ul class="footer-nav-list">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class={klasyLinku}>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-legal">
      <a href="/polityka-prywatnosci" class={klasyLinkuPrawnego}>Polityka prywatności</a>
    </div>
  </Container>
</footer>

<style>
  .footer {
    padding: 1.5rem 0;  /* py-6 */
    border-top: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  /* Telefon: jedna kolumna, wszystko wyśrodkowane */
  .footer-grid {
    display: grid;
    gap: 1.5rem;
    text-align: center;
    grid-template-columns: 1fr;
  }

  .footer-brand .copyright {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .footer-nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-legal {
    margin-top: 1rem;
    text-align: center;
  }

  /* Od tabletu w górę: podpis po lewej, linki po prawej */
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: auto 1fr;
      align-items: center;
      text-align: left;
    }

    .footer-nav-list {
      justify-content: flex-end;
    }

    .footer-legal {
      text-align: right;
    }
  }
</style>
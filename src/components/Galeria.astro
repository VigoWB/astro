---
import Karta from "./ui/Karta.astro";
import type { Zdjecie } from "../lib/galeria.ts";

interface Props {
	zdjecia: Zdjecie[];
	/** Pomijalne, gdy pokazFiltry={false} (strona główna nie pokazuje paska filtrów). */
	kategorie?: readonly string[];
	/** Pasek filtrów kategorii. Domyślnie widoczny (galeria); wyłączany na stronie głównej (Roadmapa pkt 4). */
	pokazFiltry?: boolean;
	/** Przycisk "Załaduj więcej". Domyślnie widoczny; wyłączany, gdy strona i tak pokazuje wszystkie przekazane zdjęcia naraz (strona główna). */
	pokazZaladujWiecej?: boolean;
	/** Pierwsze zdjęcie ładowane od razu (eager + fetchpriority="high"). Wyłączane na stronie głównej, gdzie galeria jest pod pierwszym ekranem. */
	priorytetPierwszego?: boolean;
}

const { zdjecia, kategorie = [], pokazFiltry = true, pokazZaladujWiecej = true, priorytetPierwszego = true } = Astro.props;

// Ile zdjęć widać na start i ile dochodzi po każdym kliknięciu "Załaduj więcej".
// Ta sama liczba trafia do skryptu niżej przez atrybut data-na-strone,
// więc jest tylko jedno miejsce do zmiany. Bez przycisku "Załaduj więcej"
// (pokazZaladujWiecej={false}) pokazujemy od razu wszystkie przekazane zdjęcia.
const NA_STRONE = pokazZaladujWiecej ? 8 : zdjecia.length;

const poczatkowoPozostalo = Math.max(zdjecia.length - NA_STRONE, 0);
---

{pokazFiltry && (
	<div class="mb-6 flex flex-wrap gap-2" role="group" aria-label="Filtruj galerię" data-testid="gallery-filters">
		{kategorie.map((kat) => (
			<button
				type="button"
				data-filter={kat}
				data-testid={`filter-${kat.toLowerCase()}`}
				class={`px-4 py-2 rounded-full border-2 transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper ${kat === "Wszystkie" ? "bg-accent text-paper border-accent" : "bg-paper text-ink border-ink/30 hover:bg-card hover:border-accent"}`}
				aria-pressed={kat === "Wszystkie"}
			>
				{kat}
			</button>
		))}
	</div>
)}

<!-- Wszystkie zdjęcia są w HTML od razu; te poza pierwszą porcją mają klasę "hidden"
     (miniatury i tak ładują się dopiero po pokazaniu — loading="lazy"). -->
<div class="columns-2 md:columns-3 lg:columns-4 xl:columns-5 2xl:columns-6 gap-3" id="galeria-grid" data-na-strone={NA_STRONE}>
	{zdjecia.map((z, index) => (
		<Karta
			po={z.po}
			lightbox={z.lightbox}
			opis={z.opis}
			kategoria={z.kategoria}
			exif={z.exif}
			priority={priorytetPierwszego && index === 0}
			ukryta={index >= NA_STRONE}
		/>
	))}
</div>

{pokazZaladujWiecej && (
	<div
		id="load-more-container"
		class:list={["text-center mt-8 mb-12", { hidden: poczatkowoPozostalo === 0 }]}
		data-testid="load-more-container"
	>
		<button
			id="load-more-btn"
			type="button"
			class="px-8 py-3 bg-accent text-paper font-semibold rounded-full hover:bg-accent/90 transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
			data-testid="load-more-btn"
		>
			Załaduj więcej (<span id="load-more-count" data-testid="load-more-count">{poczatkowoPozostalo}</span>)
		</button>
	</div>
)}

<div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/90 p-4" role="dialog" aria-modal="true" aria-label="Podgląd zdjęcia">
	<button type="button" id="lightbox-close" class="absolute top-4 right-4 text-paper text-3xl leading-none focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-ink" aria-label="Zamknij podgląd">
		&times;
	</button>

	<!-- Przeglądanie zdjęć bez zamykania podglądu (Roadmapa pkt 6). Ukryte całkiem,
	     gdy aktualnie widoczne jest tylko jedno zdjęcie (nie ma dokąd przejść);
	     na krawędziach (pierwsze/ostatnie) disabled zamiast zawijania w kółko —
	     disabled samo wypada z kolejności Tab i z pułapki fokusu. -->
	<button
		type="button"
		id="lightbox-poprzednie"
		data-testid="lightbox-poprzednie"
		class="absolute left-2 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-ink/30 text-3xl leading-none text-paper transition-colors hover:bg-ink/50 disabled:pointer-events-none disabled:opacity-0 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-ink sm:left-4"
		aria-label="Poprzednie zdjęcie"
	>
		&lsaquo;
	</button>
	<button
		type="button"
		id="lightbox-nastepne"
		data-testid="lightbox-nastepne"
		class="absolute right-2 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-ink/30 text-3xl leading-none text-paper transition-colors hover:bg-ink/50 disabled:pointer-events-none disabled:opacity-0 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-ink sm:right-4"
		aria-label="Następne zdjęcie"
	>
		&rsaquo;
	</button>

	<div class="flex max-h-full max-w-full flex-col items-center gap-4">
		<img
			id="lightbox-img"
			alt=""
			draggable="false"
			tabindex="0"
			class="max-h-[calc(100dvh-10rem)] max-w-full object-contain select-none focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-ink"
		/>
		<div class="flex items-center gap-4 text-paper">
			<span id="lightbox-opis" class="font-bold" tabindex="0"></span>
			<!-- Widoczny przełącznik zamiast najechania myszką/przytrzymania palca —
			     działa z klawiatury i czytnika ekranu (Roadmapa pkt 9). -->
			<button
				type="button"
				id="lightbox-przelacznik"
				aria-pressed="false"
				data-testid="lightbox-przelacznik"
				class="hidden rounded-full border-2 border-paper/50 px-4 py-1.5 text-sm font-semibold text-paper transition-colors hover:border-paper focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-ink aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-paper"
			>
				Pokaż przed
			</button>
		</div>
		<!-- Licznik "3 / 10" — tylko wśród zdjęć aktualnie widocznych (filtr, "Załaduj więcej").
		     Czytnik ekranu go pomija — pełne ogłoszenie (numer i opis) jest w spanie niżej. -->
		<span id="lightbox-licznik" class="text-sm text-paper/70" data-testid="lightbox-licznik" aria-hidden="true"></span>
		<!-- Dla czytnika ekranu: numer zdjęcia RAZEM z opisem (sam licznik nic nie mówi o zdjęciu). -->
		<span id="lightbox-ogloszenie" class="sr-only" aria-live="polite"></span>
		<!-- Dane z aparatu (ISO, przysłona, ogniskowa, czas) -->
		<div id="lightbox-exif" class="text-sm text-paper/70 font-mono hidden"></div>
	</div>
</div>

<script>
	const grid = document.getElementById("galeria-grid")!;
	const NA_STRONE = Number(grid.dataset.naStrone) || 8;

	const wszystkieKarty = Array.from(document.querySelectorAll<HTMLElement>("[data-gallery-item]"));
	const przyciskiFiltrow = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
	// Przycisk "Załaduj więcej" nie istnieje w HTML, gdy komponent dostał pokazZaladujWiecej={false}
	// (strona główna, Roadmapa pkt 4) — stąd zapytania mogą zwrócić null.
	const loadMoreBtn = document.getElementById("load-more-btn");
	const loadMoreCount = document.getElementById("load-more-count");
	const loadMoreContainer = document.getElementById("load-more-container");

	let aktywnyFiltr = "Wszystkie";
	let limit = NA_STRONE; // ile zdjęć (spełniających filtr) ma być teraz widocznych

	// --- Fade-in zdjęć przy wjeździe w viewport ---
	const preferujeMniejRuchu = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const obserwator = preferujeMniejRuchu
		? null
		: new IntersectionObserver(
				(wpisy, obs) => {
					wpisy.forEach((wpis) => {
						if (wpis.isIntersecting) {
							wpis.target.classList.remove("opacity-0", "translate-y-6");
							obs.unobserve(wpis.target);
						}
					});
				},
				{ threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
			);

	function nieodkryteWidoczne(): HTMLElement[] {
		return wszystkieKarty.filter(
			(el) => !el.classList.contains("hidden") && el.classList.contains("opacity-0")
		);
	}

	// Opóźnienie liczymy z realnej pozycji Y karty, żeby "fala" szła
	// rzędami (wizualnie), a nie kolumnami układu masonry.
	function ustawKolejnoscWierszami(elementy: HTMLElement[]) {
		const posortowane = elementy
			.map((el) => ({
				el,
				top: el.getBoundingClientRect().top + window.scrollY,
			}))
			.sort((a, b) => a.top - b.top);

		let rzad = 0;
		let ostatniTop: number | null = null;
		const tolerancja = 24; // px — w tym zakresie liczy się jako ten sam "rząd"

		posortowane.forEach(({ el, top }) => {
			if (ostatniTop === null || Math.abs(top - ostatniTop) > tolerancja) {
				rzad++;
				ostatniTop = top;
			}
			el.style.transitionDelay = `${Math.min(rzad * 60, 360)}ms`;
		});
	}

	// Wywoływane po każdej zmianie widocznych zdjęć (start, filtr, "Załaduj więcej").
	function przygotujAnimacje() {
		const doOdkrycia = nieodkryteWidoczne();

		if (!obserwator) {
			// Bez animacji — po prostu pokaż od razu.
			doOdkrycia.forEach((el) => el.classList.remove("opacity-0", "translate-y-6"));
			return;
		}

		ustawKolejnoscWierszami(doOdkrycia);
		doOdkrycia.forEach((el) => obserwator.observe(el));
	}

	// --- Filtr + "Załaduj więcej": jedna funkcja decyduje, co jest widoczne ---
	function pasujeDoFiltra(el: HTMLElement): boolean {
		if (aktywnyFiltr === "Wszystkie") return true;
		// Lista zapisana jako JSON (Karta.astro) — kategoria może mieć spację, np. "Zdjęcia produktowe".
		const kategorieKarty: string[] = JSON.parse(el.dataset.kategoria || "[]");
		return kategorieKarty.includes(aktywnyFiltr);
	}

	function odswiez() {
		let pasujace = 0;

		wszystkieKarty.forEach((el) => {
			if (pasujeDoFiltra(el)) {
				pasujace++;
				el.classList.toggle("hidden", pasujace > limit);
			} else {
				el.classList.add("hidden");
			}
		});

		const pozostalo = Math.max(pasujace - limit, 0);
		if (loadMoreCount) loadMoreCount.textContent = String(pozostalo);
		loadMoreContainer?.classList.toggle("hidden", pozostalo === 0);

		przygotujAnimacje();
	}

	loadMoreBtn?.addEventListener("click", () => {
		const bylo = aktualnaLista().length;
		const zKlawiatury = document.activeElement?.matches(":focus-visible") ?? false;
		limit += NA_STRONE;
		odswiez();
		// Ostatnia porcja chowa przycisk — fokus spadłby na <body>, a następny Tab do stopki.
		if (zKlawiatury && loadMoreContainer?.classList.contains("hidden")) {
			aktualnaLista()[bylo]?.focus();
		}
	});

	const KLASY_AKTYWNY = ["bg-accent", "text-paper", "border-accent"];
	const KLASY_NIEAKTYWNY = ["bg-paper", "text-ink", "border-ink/30", "hover:bg-card", "hover:border-accent"];

	przyciskiFiltrow.forEach((btn) => {
		btn.addEventListener("click", () => {
			aktywnyFiltr = btn.dataset.filter || "Wszystkie";
			limit = NA_STRONE; // po zmianie filtra zaczynamy od pierwszej porcji

			przyciskiFiltrow.forEach((b) => {
				const aktywny = b.dataset.filter === aktywnyFiltr;
				b.setAttribute("aria-pressed", String(aktywny));
				// Zmieniamy też wygląd przycisku, żeby było widać, który filtr jest włączony.
				b.classList.remove(...(aktywny ? KLASY_NIEAKTYWNY : KLASY_AKTYWNY));
				b.classList.add(...(aktywny ? KLASY_AKTYWNY : KLASY_NIEAKTYWNY));
			});

			odswiez();
		});
	});

	// --- Płynne pojawienie się miniatury po wczytaniu (rozmycie → ostre) ---
	// Wcześniej robił to atrybut onload="..." w Karta.astro. Przeniesione tutaj, bo:
	// 1) kod w atrybucie HTML zablokuje przyszła polityka CSP → miniatury zostałyby niewidoczne,
	// 2) tu obsługujemy też zdjęcia już wczytane (z cache) i te, których nie udało się pobrać.
	function pokazMiniature(img: HTMLImageElement) {
		img.classList.remove("opacity-0", "blur-md", "scale-105");
	}

	document.querySelectorAll<HTMLImageElement>("[data-miniatura].opacity-0").forEach((img) => {
		if (img.complete) {
			// Już wczytane (albo błąd pobierania) — pokazujemy od razu.
			pokazMiniature(img);
			return;
		}
		img.addEventListener("load", () => pokazMiniature(img), { once: true });
		// Przy błędzie też pokazujemy — wtedy widać chociaż opis (alt), a nie pustą ramkę.
		img.addEventListener("error", () => pokazMiniature(img), { once: true });
	});

	odswiez();
	// Zdjęcia mogą jeszcze przesunąć układ po doładowaniu — przeliczamy raz jeszcze.
	window.addEventListener("load", () => ustawKolejnoscWierszami(nieodkryteWidoczne()), { once: true });

	// --- Lightbox z focus trap ---
	const lightbox = document.getElementById("lightbox")!;
	const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
	const lightboxOpis = document.getElementById("lightbox-opis")!;
	const przelacznikBtn = document.getElementById("lightbox-przelacznik") as HTMLButtonElement;
	const lightboxExif = document.getElementById("lightbox-exif")!;
	const closeBtn = document.getElementById("lightbox-close")!;
	const poprzednieBtn = document.getElementById("lightbox-poprzednie") as HTMLButtonElement;
	const nastepneBtn = document.getElementById("lightbox-nastepne") as HTMLButtonElement;
	const lightboxLicznik = document.getElementById("lightbox-licznik")!;
	const lightboxOgloszenie = document.getElementById("lightbox-ogloszenie")!;

	// Zmniejszona wersja zdjęcia (webp z /_astro/) — przygotowana przy buildzie w src/lib/galeria.ts.
	interface WersjaZdjecia {
		src: string;
		srcset: string;
		sizes: string;
	}

	const current: { po: WersjaZdjecia | null; przed: WersjaZdjecia | null } = { po: null, przed: null };
	let lastFocusedElement: HTMLElement | null = null;

	// Przeglądanie w lightboxie: lista i pozycja liczone tylko wśród zdjęć aktualnie
	// widocznych w galerii (po filtrze i "Załaduj więcej"), nie wśród wszystkich.
	let aktualnaListaZdjec: HTMLElement[] = [];
	let aktualnyIndeks = -1;

	function aktualnaLista(): HTMLElement[] {
		return wszystkieKarty.filter((el) => !el.classList.contains("hidden"));
	}

	// Czyta z karty adresy wersji "po" albo "przed" (atrybuty data-po*, data-przed*).
	function wersjaZKarty(item: HTMLElement, ktora: "po" | "przed"): WersjaZdjecia | null {
		const src = item.getAttribute(`data-${ktora}`) || "";
		if (!src) return null;
		return {
			src,
			srcset: item.getAttribute(`data-${ktora}-srcset`) || "",
			sizes: item.getAttribute(`data-${ktora}-sizes`) || "",
		};
	}

	// Podmienia zdjęcie. Najpierw sizes i srcset, potem src — przeglądarka
	// sama wybierze rozmiar pasujący do ekranu (mniejszy na telefonie).
	function ustawZdjecie(img: HTMLImageElement, wersja: WersjaZdjecia) {
		img.sizes = wersja.sizes;
		img.srcset = wersja.srcset;
		img.src = wersja.src;
	}

	// Elementy, po których krąży Tab wewnątrz lightboxa (tylko te, które są teraz widoczne
	// i nie są disabled — na krawędziach listy poprzednie/następne są disabled).
	function elementyFokusowalne(): HTMLElement[] {
		return Array.from(
			lightbox.querySelectorAll<HTMLElement>(
				"#lightbox-close, #lightbox-poprzednie, #lightbox-nastepne, #lightbox-img, #lightbox-opis, #lightbox-przelacznik"
			)
		).filter((el) => el.getClientRects().length > 0 && !(el as HTMLButtonElement).disabled);
	}

	// Wczytuje dane pojedynczego zdjęcia do już otwartego lightboxa — używane
	// zarówno przy pierwszym otwarciu, jak i przy przejściu poprzednie/następne.
	function zaladujDane(item: HTMLElement) {
		current.po = wersjaZKarty(item, "po");
		current.przed = wersjaZKarty(item, "przed");

		pokazPo();
		lightboxImg.alt = item.dataset.opis || "Zdjęcie z portfolio fotograficznego Wiktora";
		lightboxOpis.textContent = item.dataset.opis || "";
		// Pusty opis byłby pustym przystankiem Tab (0×0 px) — chowamy go całkiem.
		lightboxOpis.classList.toggle("hidden", !item.dataset.opis);

		przelacznikBtn.classList.toggle("hidden", !current.przed);
		// Przełącznik "Pokaż przed" resetuje się przy każdej zmianie zdjęcia (Roadmapa pkt 6).
		przelacznikBtn.setAttribute("aria-pressed", "false");

		// Wersję "przed" pobieramy już teraz, żeby przełącznik pokazał ją bez czekania.
		// Te same sizes i srcset co w lightboxie = przeglądarka pobierze ten sam plik.
		if (current.przed) {
			ustawZdjecie(new Image(), current.przed);
		}

		// Dane z aparatu — gotowy tekst z atrybutu karty (może być pusty).
		const exif = item.dataset.exif || "";
		lightboxExif.textContent = exif;
		lightboxExif.classList.toggle("hidden", !exif);

		aktualizujNawigacje();
		wczytajZWyprzedzeniem();

		// Przycisk z fokusem właśnie zniknął albo się wyłączył ("Następne" na ostatnim zdjęciu,
		// "Pokaż przed" przy zdjęciu bez wersji "przed") — fokus spadłby na <body>.
		const aktywny = document.activeElement;
		const fokusZgubiony =
			!aktywny || aktywny === document.body || (lightbox.contains(aktywny) && !elementyFokusowalne().includes(aktywny as HTMLElement));
		if (!lightbox.classList.contains("hidden") && fokusZgubiony) lightboxImg.focus();
	}

	// Licznik "3 / 10" + stan przycisków poprzednie/następne (disabled na krawędziach,
	// cała nawigacja ukryta, gdy w aktualnym widoku jest tylko jedno zdjęcie).
	function aktualizujNawigacje() {
		const liczbaZdjec = aktualnaListaZdjec.length;
		lightboxLicznik.textContent = liczbaZdjec > 0 ? `${aktualnyIndeks + 1} / ${liczbaZdjec}` : "";
		const opisDoOgloszenia = lightboxOpis.textContent ? `: ${lightboxOpis.textContent}` : "";
		lightboxOgloszenie.textContent = liczbaZdjec > 1 ? `Zdjęcie ${aktualnyIndeks + 1} z ${liczbaZdjec}${opisDoOgloszenia}` : "";

		poprzednieBtn.disabled = aktualnyIndeks <= 0;
		nastepneBtn.disabled = aktualnyIndeks >= liczbaZdjec - 1;

		const pokazNawigacje = liczbaZdjec > 1;
		poprzednieBtn.classList.toggle("hidden", !pokazNawigacje);
		nastepneBtn.classList.toggle("hidden", !pokazNawigacje);
		lightboxLicznik.classList.toggle("hidden", !pokazNawigacje);
	}

	// Wczytuje z wyprzedzeniem kolejne zdjęcie w kolejności, żeby "następne" nie czekało
	// na pobranie pliku (Roadmapa pkt 6, "ewentualnie wczytanie z wyprzedzeniem").
	function wczytajZWyprzedzeniem() {
		const nastepneZdjecie = aktualnaListaZdjec[aktualnyIndeks + 1];
		if (!nastepneZdjecie) return;
		const wersja = wersjaZKarty(nastepneZdjecie, "po");
		if (wersja) ustawZdjecie(new Image(), wersja);
	}

	function przejdzDo(indeks: number) {
		if (indeks < 0 || indeks >= aktualnaListaZdjec.length) return;
		aktualnyIndeks = indeks;
		zaladujDane(aktualnaListaZdjec[indeks]);
	}

	function poprzednie() {
		przejdzDo(aktualnyIndeks - 1);
	}

	function nastepne() {
		przejdzDo(aktualnyIndeks + 1);
	}

	function otworz(item: HTMLElement) {
		aktualnaListaZdjec = aktualnaLista();
		aktualnyIndeks = aktualnaListaZdjec.indexOf(item);

		zaladujDane(item);

		// Zapisz element, który miał focus przed otwarciem
		lastFocusedElement = document.activeElement as HTMLElement;

		lightbox.classList.remove("hidden");
		lightbox.classList.add("flex");
		// Strona pod lightboksem nie przewija się (kółko myszy, palec po czarnym tle).
		document.documentElement.classList.add("overflow-hidden");

		// Focus trap: ustaw focus na przycisku zamknij (pierwszy w kolejności)
		// Użyj setTimeout z krótkim opóźnieniem dla pewności renderowania
		setTimeout(() => {
			closeBtn.focus();
		}, 10);

		// Dodaj listener focus trap
		document.addEventListener("keydown", handleFocusTrap);
	}

	function zamknij() {
		lightbox.classList.add("hidden");
		lightbox.classList.remove("flex");
		document.documentElement.classList.remove("overflow-hidden");
		pokazPo();

		// Usuń focus trap
		document.removeEventListener("keydown", handleFocusTrap);

		// Przywróć focus na karcie, z której otworzono
		if (lastFocusedElement) {
			lastFocusedElement.focus();
		}
	}

	// Podmiana zdjęcia w lightboksie. Jeśli nowy plik nie wczyta się w 150 ms, stare zdjęcie
	// znika — inaczej na wolnym łączu widać stare zdjęcie z nowym opisem i licznikiem.
	let wygaszenie = 0;
	function pokazWLightboksie(wersja: WersjaZdjecia) {
		window.clearTimeout(wygaszenie);
		if (lightboxImg.getAttribute("src") !== wersja.src) {
			wygaszenie = window.setTimeout(() => lightboxImg.classList.add("opacity-0"), 150);
		}
		ustawZdjecie(lightboxImg, wersja);
	}
	function pokazWczytane() {
		window.clearTimeout(wygaszenie);
		lightboxImg.classList.remove("opacity-0");
	}
	lightboxImg.addEventListener("load", pokazWczytane);
	lightboxImg.addEventListener("error", pokazWczytane);

	function pokazPrzed() {
		if (current.przed) pokazWLightboksie(current.przed);
	}

	function pokazPo() {
		if (current.po) pokazWLightboksie(current.po);
	}

	wszystkieKarty.forEach((item) => {
		// Karta to <button>: Enter i Spacja same wywołują "click".
		item.addEventListener("click", () => otworz(item));
	});

	closeBtn.addEventListener("click", zamknij);

	poprzednieBtn.addEventListener("click", poprzednie);
	nastepneBtn.addEventListener("click", nastepne);

	// Przesuwanie palcem po zdjęciu (telefon) — w lewo: następne, w prawo: poprzednie.
	// Liczy się tylko gest JEDNYM palcem, wyraźnie poziomy, bez powiększenia strony —
	// dwa palce to powiększanie zdjęcia, a ruch w pionie to nie "następne".
	let dotykStartX = 0;
	let dotykStartY = 0;
	let dotykDwaPalce = false;
	const PROG_PRZESUNIECIA = 50; // px — poniżej tego traktujemy to jak zwykłe stuknięcie

	lightboxImg.addEventListener(
		"touchstart",
		(e) => {
			dotykDwaPalce = e.touches.length > 1;
			if (dotykDwaPalce) return;
			dotykStartX = e.changedTouches[0].clientX;
			dotykStartY = e.changedTouches[0].clientY;
		},
		{ passive: true }
	);

	lightboxImg.addEventListener(
		"touchend",
		(e) => {
			// Był (albo wciąż jest) drugi palec, albo strona jest powiększona — to nie przesunięcie.
			if (dotykDwaPalce || e.touches.length > 0) return;
			if (window.visualViewport && window.visualViewport.scale > 1.01) return;
			const delta = e.changedTouches[0].clientX - dotykStartX;
			const deltaY = e.changedTouches[0].clientY - dotykStartY;
			if (Math.abs(delta) < PROG_PRZESUNIECIA || Math.abs(delta) <= Math.abs(deltaY)) return;
			if (delta < 0) {
				nastepne();
			} else {
				poprzednie();
			}
		},
		{ passive: true }
	);

	// Przełącznik "Pokaż przed" — ta sama obsługa dla klawiatury, myszki i dotyku
	// (wcześniej trzeba było najechać myszką albo przytrzymać palec: nie dało się
	// tego zrobić z klawiatury, a na komputerze powiększenie czasem otwierało się
	// pod kursorem i "przed" pokazywało się od razu, zanim ktoś zobaczył "po").
	przelacznikBtn.addEventListener("click", () => {
		const pokazujePrzed = przelacznikBtn.getAttribute("aria-pressed") === "true";
		przelacznikBtn.setAttribute("aria-pressed", String(!pokazujePrzed));
		if (pokazujePrzed) {
			pokazPo();
		} else {
			pokazPrzed();
		}
	});

	lightbox.addEventListener("click", (e) => {
		// e.detail = 2: drugie kliknięcie dwukliku w kartę trafia już w tło świeżo
		// otwartego lightboxa — bez tego warunku podgląd od razu by się zamykał.
		if (e.target === lightbox && e.detail < 2) zamknij();
	});

	document.addEventListener("keydown", (e) => {
		// Wszystkie te klawisze działają tylko przy otwartym lightboxie — inaczej
		// zabierałyby focus stronie (np. strzałki przewijające zwykłą galerię).
		if (lightbox.classList.contains("hidden")) return;

		if (e.key === "Escape") {
			zamknij();
		} else if (e.key === "ArrowLeft") {
			e.preventDefault();
			poprzednie();
		} else if (e.key === "ArrowRight") {
			e.preventDefault();
			nastepne();
		}
	});

	// Focus trap handler dla Tab / Shift+Tab
	function handleFocusTrap(e: KeyboardEvent) {
		if (e.key !== "Tab") return;

		const focusableElements = elementyFokusowalne();
		if (focusableElements.length === 0) return;

		const firstElement = focusableElements[0];
		const lastElement = focusableElements[focusableElements.length - 1];
		// Fokus poza listą (kliknięcie w licznik albo EXIF przenosi go na <main tabindex="-1">
		// pod lightboksem) — wtedy Tab też wraca do lightboxa, a nie idzie na stronę pod spodem.
		const fokusWSrodku = focusableElements.includes(document.activeElement as HTMLElement);

		if (e.shiftKey) {
			// Shift+Tab – cofnij
			if (!fokusWSrodku || document.activeElement === firstElement) {
				e.preventDefault();
				lastElement.focus();
			}
		} else {
			// Tab – do przodu
			if (!fokusWSrodku || document.activeElement === lastElement) {
				e.preventDefault();
				firstElement.focus();
			}
		}
	}

	// Blokada prawoklika na zdjęciach — utrudnienie, nie realna ochrona
	wszystkieKarty.forEach((item) => {
		item.addEventListener("contextmenu", (e) => e.preventDefault());
	});
	lightboxImg.addEventListener("contextmenu", (e) => e.preventDefault());
</script>

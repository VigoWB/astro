---
import Karta from "./ui/Karta.astro";

interface Props {
	zdjecia: Array<{
		po: { src: string; width: number; height: number };
		przed?: { src: string };
		opis: string;
		kategoria: string[];
		exif?: {
			iso?: number | null;
			przyslona?: number | null;
			ogniskowa?: number | null;
			czasNaswietlania?: number | null;
			make?: string | null;
			model?: string | null;
			lensModel?: string | null;
		};
	}>;
	kategorie: readonly string[];
}

const { zdjecia, kategorie } = Astro.props;

// Ile zdjęć widać na start i ile dochodzi po każdym kliknięciu "Załaduj więcej".
// Ta sama liczba trafia do skryptu niżej przez atrybut data-na-strone,
// więc jest tylko jedno miejsce do zmiany.
const NA_STRONE = 8;

const poczatkowoPozostalo = Math.max(zdjecia.length - NA_STRONE, 0);
---

<div class="flex flex-wrap gap-2 mb-6" role="group" aria-label="Filtruj galerię" data-testid="gallery-filters">
	{kategorie.map((kat) => (
		<button
			type="button"
			data-filter={kat}
			data-testid={`filter-${kat.toLowerCase()}`}
			class={`px-4 py-2 rounded-full border-2 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper ${kat === "Wszystkie" ? "bg-accent text-paper border-accent" : "bg-paper text-ink border-ink/30 hover:bg-card hover:border-accent"}`}
			aria-pressed={kat === "Wszystkie"}
		>
			{kat}
		</button>
	))}
</div>

<!-- Wszystkie zdjęcia są w HTML od razu; te poza pierwszą porcją mają klasę "hidden"
     (miniatury i tak ładują się dopiero po pokazaniu — loading="lazy"). -->
<div class="columns-2 md:columns-3 lg:columns-4 xl:columns-5 2xl:columns-6 gap-3" id="galeria-grid" data-na-strone={NA_STRONE}>
	{zdjecia.map((z, index) => (
		<Karta
			po={z.po}
			przed={z.przed}
			opis={z.opis}
			kategoria={z.kategoria}
			exif={z.exif}
			priority={index === 0}
			ukryta={index >= NA_STRONE}
		/>
	))}
</div>

<!-- Load More Button -->
<div
	id="load-more-container"
	class:list={["text-center mt-8", { hidden: poczatkowoPozostalo === 0 }]}
	data-testid="load-more-container"
>
	<button
		id="load-more-btn"
		type="button"
		class="px-8 py-3 bg-accent text-paper font-semibold rounded-full hover:bg-accent/90 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
		aria-label="Załaduj więcej zdjęć"
		data-testid="load-more-btn"
	>
		Załaduj więcej (<span id="load-more-count" data-testid="load-more-count">{poczatkowoPozostalo}</span>)
	</button>
</div>

<div id="lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4">
	<button type="button" id="lightbox-close" tabindex="0" class="absolute top-4 right-4 text-white text-3xl leading-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-black" aria-label="Zamknij podgląd">
		&times;
	</button>

	<div class="flex max-h-full max-w-full flex-col items-center gap-4">
		<img
			id="lightbox-img"
			src=""
			alt=""
			draggable="false"
			tabindex="0"
			class="max-h-[80vh] max-w-full object-contain select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-black"
		/>
		<div class="flex items-center gap-4 text-white">
			<span id="lightbox-opis" class="font-bold" tabindex="0"></span>
			<span id="lightbox-hint" class="hidden text-sm text-white/70 italic select-none" tabindex="0">
				Najedź / przytrzymaj, aby zobaczyć: przed
			</span>
		</div>
		<!-- Dane z aparatu (ISO, przysłona, ogniskowa, czas) -->
		<div id="lightbox-exif" class="text-sm text-white/70 font-mono hidden"></div>
	</div>
</div>

<script>
	const grid = document.getElementById("galeria-grid")!;
	const NA_STRONE = Number(grid.dataset.naStrone) || 8;

	const wszystkieKarty = Array.from(document.querySelectorAll<HTMLElement>("[data-gallery-item]"));
	const przyciskiFiltrow = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
	const loadMoreBtn = document.getElementById("load-more-btn")!;
	const loadMoreCount = document.getElementById("load-more-count")!;
	const loadMoreContainer = document.getElementById("load-more-container")!;

	let aktywnyFiltr = "Wszystkie";
	let limit = NA_STRONE; // ile zdjęć (spełniających filtr) ma być teraz widocznych

	// --- Fade-in zdjęć przy wjeździe w viewport ---
	const preferujeMniejRuchu = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	const obserwator = preferujeMniejRuchu
		? null
		: new IntersectionObserver(
				(wpisy, obs) => {
					wpisy.forEach((wpis) => {
						if (wpis.isIntersecting) {
							wpis.target.classList.remove("opacity-0", "translate-y-6");
							obs.unobserve(wpis.target);
						}
					});
				},
				{ threshold: 0.15, rootMargin: "0px 0px -60px 0px" }
			);

	function nieodkryteWidoczne(): HTMLElement[] {
		return wszystkieKarty.filter(
			(el) => !el.classList.contains("hidden") && el.classList.contains("opacity-0")
		);
	}

	// Opóźnienie liczymy z realnej pozycji Y karty, żeby "fala" szła
	// rzędami (wizualnie), a nie kolumnami układu masonry.
	function ustawKolejnoscWierszami(elementy: HTMLElement[]) {
		const posortowane = elementy
			.map((el) => ({
				el,
				top: el.getBoundingClientRect().top + window.scrollY,
			}))
			.sort((a, b) => a.top - b.top);

		let rzad = 0;
		let ostatniTop: number | null = null;
		const tolerancja = 24; // px — w tym zakresie liczy się jako ten sam "rząd"

		posortowane.forEach(({ el, top }) => {
			if (ostatniTop === null || Math.abs(top - ostatniTop) > tolerancja) {
				rzad++;
				ostatniTop = top;
			}
			el.style.transitionDelay = `${Math.min(rzad * 60, 360)}ms`;
		});
	}

	// Wywoływane po każdej zmianie widocznych zdjęć (start, filtr, "Załaduj więcej").
	function przygotujAnimacje() {
		const doOdkrycia = nieodkryteWidoczne();

		if (!obserwator) {
			// Bez animacji — po prostu pokaż od razu.
			doOdkrycia.forEach((el) => el.classList.remove("opacity-0", "translate-y-6"));
			return;
		}

		ustawKolejnoscWierszami(doOdkrycia);
		doOdkrycia.forEach((el) => obserwator.observe(el));
	}

	// --- Filtr + "Załaduj więcej": jedna funkcja decyduje, co jest widoczne ---
	function pasujeDoFiltra(el: HTMLElement): boolean {
		if (aktywnyFiltr === "Wszystkie") return true;
		return (el.dataset.kategoria ?? "").split(" ").includes(aktywnyFiltr);
	}

	function odswiez() {
		let pasujace = 0;

		wszystkieKarty.forEach((el) => {
			if (pasujeDoFiltra(el)) {
				pasujace++;
				el.classList.toggle("hidden", pasujace > limit);
			} else {
				el.classList.add("hidden");
			}
		});

		const pozostalo = Math.max(pasujace - limit, 0);
		loadMoreCount.textContent = String(pozostalo);
		loadMoreContainer.classList.toggle("hidden", pozostalo === 0);

		przygotujAnimacje();
	}

	loadMoreBtn.addEventListener("click", () => {
		limit += NA_STRONE;
		odswiez();
	});

	const KLASY_AKTYWNY = ["bg-accent", "text-paper", "border-accent"];
	const KLASY_NIEAKTYWNY = ["bg-paper", "text-ink", "border-ink/30", "hover:bg-card", "hover:border-accent"];

	przyciskiFiltrow.forEach((btn) => {
		btn.addEventListener("click", () => {
			aktywnyFiltr = btn.dataset.filter || "Wszystkie";
			limit = NA_STRONE; // po zmianie filtra zaczynamy od pierwszej porcji

			przyciskiFiltrow.forEach((b) => {
				const aktywny = b.dataset.filter === aktywnyFiltr;
				b.setAttribute("aria-pressed", String(aktywny));
				// Zmieniamy też wygląd przycisku, żeby było widać, który filtr jest włączony.
				b.classList.remove(...(aktywny ? KLASY_NIEAKTYWNY : KLASY_AKTYWNY));
				b.classList.add(...(aktywny ? KLASY_AKTYWNY : KLASY_NIEAKTYWNY));
			});

			odswiez();
		});
	});

	odswiez();
	// Zdjęcia mogą jeszcze przesunąć układ po doładowaniu — przeliczamy raz jeszcze.
	window.addEventListener("load", () => ustawKolejnoscWierszami(nieodkryteWidoczne()), { once: true });

	// --- Lightbox z focus trap ---
	const lightbox = document.getElementById("lightbox")!;
	const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement;
	const lightboxOpis = document.getElementById("lightbox-opis")!;
	const hint = document.getElementById("lightbox-hint")!;
	const lightboxExif = document.getElementById("lightbox-exif")!;
	const closeBtn = document.getElementById("lightbox-close")!;

	const current = { po: "", przed: "" };
	let lastFocusedElement: HTMLElement | null = null;

	// Elementy, po których krąży Tab wewnątrz lightboxa (tylko te, które są teraz widoczne).
	function elementyFokusowalne(): HTMLElement[] {
		return Array.from(
			lightbox.querySelectorAll<HTMLElement>("#lightbox-close, #lightbox-img, #lightbox-opis, #lightbox-hint")
		).filter((el) => el.getClientRects().length > 0);
	}

	function otworz(item: HTMLElement) {
		current.po = item.dataset.po || "";
		current.przed = item.dataset.przed || "";

		lightboxImg.src = current.po;
		lightboxImg.alt = item.dataset.opis || "Zdjęcie z portfolio fotograficznego Wiktora";
		lightboxOpis.textContent = item.dataset.opis || "";

		hint.classList.toggle("hidden", !current.przed);

		// Wersję "przed" pobieramy już teraz, żeby przy najechaniu nie było czekania.
		if (current.przed) {
			const wczesniej = new Image();
			wczesniej.src = current.przed;
		}

		// Dane z aparatu — gotowy tekst z atrybutu karty (może być pusty).
		const exif = item.dataset.exif || "";
		lightboxExif.textContent = exif;
		lightboxExif.classList.toggle("hidden", !exif);

		// Zapisz element, który miał focus przed otwarciem
		lastFocusedElement = document.activeElement as HTMLElement;

		lightbox.classList.remove("hidden");
		lightbox.classList.add("flex");

		// Focus trap: ustaw focus na przycisku zamknij (pierwszy w kolejności)
		// Użyj setTimeout z krótkim opóźnieniem dla pewności renderowania
		setTimeout(() => {
			closeBtn.focus();
		}, 10);

		// Dodaj listener focus trap
		document.addEventListener("keydown", handleFocusTrap);
	}

	function zamknij() {
		lightbox.classList.add("hidden");
		lightbox.classList.remove("flex");
		pokazPo();

		// Usuń focus trap
		document.removeEventListener("keydown", handleFocusTrap);

		// Przywróć focus na karcie, z której otworzono
		if (lastFocusedElement) {
			lastFocusedElement.focus();
		}
	}

	function pokazPrzed() {
		if (current.przed) lightboxImg.src = current.przed;
	}

	function pokazPo() {
		lightboxImg.src = current.po;
	}

	wszystkieKarty.forEach((item) => {
		item.addEventListener("click", () => otworz(item));
		// Obsługa klawiatury: Enter/Space otwiera lightbox
		item.addEventListener("keydown", (e) => {
			if (e.key === "Enter" || e.key === " ") {
				e.preventDefault();
				otworz(item);
			}
		});
	});

	closeBtn.addEventListener("click", zamknij);

	// Desktop – najechanie myszką
	lightboxImg.addEventListener("mouseenter", pokazPrzed);
	lightboxImg.addEventListener("mouseleave", pokazPo);

	// Mobile – przytrzymanie palca
	lightboxImg.addEventListener("touchstart", (e) => {
		e.preventDefault();
		pokazPrzed();
	}, { passive: false });
	lightboxImg.addEventListener("touchend", pokazPo);
	lightboxImg.addEventListener("touchcancel", pokazPo);

	lightbox.addEventListener("click", (e) => {
		if (e.target === lightbox) zamknij();
	});

	document.addEventListener("keydown", (e) => {
		// Escape działa tylko przy otwartym lightboxie — inaczej zabierałby focus stronie.
		if (e.key === "Escape" && !lightbox.classList.contains("hidden")) zamknij();
	});

	// Focus trap handler dla Tab / Shift+Tab
	function handleFocusTrap(e: KeyboardEvent) {
		if (e.key !== "Tab") return;

		const focusableElements = elementyFokusowalne();
		if (focusableElements.length === 0) return;

		const firstElement = focusableElements[0];
		const lastElement = focusableElements[focusableElements.length - 1];

		if (e.shiftKey) {
			// Shift+Tab – cofnij
			if (document.activeElement === firstElement) {
				e.preventDefault();
				lastElement.focus();
			}
		} else {
			// Tab – do przodu
			if (document.activeElement === lastElement) {
				e.preventDefault();
				firstElement.focus();
			}
		}
	}

	// Blokada prawoklika na zdjęciach — utrudnienie, nie realna ochrona
	wszystkieKarty.forEach((item) => {
		item.addEventListener("contextmenu", (e) => e.preventDefault());
	});
	lightboxImg.addEventListener("contextmenu", (e) => e.preventDefault());
</script>

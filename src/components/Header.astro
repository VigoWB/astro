---
import Container from "../components/ui/Container.astro";
import Logo from "../assets/logo.svg";
import { navLinks } from "../data/nav.ts";

const currentPath = Astro.url.pathname;
---

<!-- Jeden nagłówek, dwa układy:
     - telefon i tablet (do 1023 px): pasek u góry. Na samej górze strony ma 96 px
       i duże logo, po przewinięciu zwija się do 60 px (skrypt niżej ustawia
       data-zwiniety). W układzie strony <header> zajmuje zawsze 60 px + 36 px odstępu
       (mb-9), a duży pasek tylko nachodzi na ten odstęp — dlatego zwijanie nie
       przesuwa treści i pasek nie miga na granicy.
     - komputer (od lg = 1024 px): pasek boczny przyklejony do lewej krawędzi okna,
       z dużym logo i menu w pionie. Miejsce robi mu lg:pl-64 na <body> w Layout.astro
       (zmieniasz szerokość paska — zmień w obu miejscach). -->
<header
	id="naglowek"
	class="group sticky top-0 z-40 mb-9 h-15 bg-paper text-ink text-xl font-semibold lg:fixed lg:inset-y-0 lg:left-0 lg:mb-0 lg:h-auto lg:w-64 lg:overflow-y-auto lg:border-r lg:border-line"
>
	<div
		id="pasek-naglowka"
		class="absolute inset-x-0 top-0 flex h-24 items-center border-b border-line bg-paper motion-safe:transition-[height,box-shadow] motion-safe:duration-300 max-lg:group-data-zwiniety:h-15 max-lg:group-data-zwiniety:shadow-md lg:static lg:block lg:h-auto lg:border-b-0"
	>
		<Container>
			<div class="flex flex-row items-center justify-between lg:flex-col lg:items-start lg:justify-start lg:gap-10 lg:px-4 lg:py-10">
				<!-- Logo wstawiane jako SVG prosto w HTML — kolor bierze z tekstu nagłówka
				     (text-ink), więc po zmianie tokenu w global.css zmienia się samo.
				     Ten sam plik rysuje znak wodny na zdjęciach (scripts/sync-images.mjs). -->
				<a
					href="/"
					aria-label="balansbieli.pl — strona główna"
					class="block rounded-xs focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
				>
					<Logo
						class="h-20 w-auto motion-safe:transition-[height] motion-safe:duration-300 max-lg:group-data-zwiniety:h-11 lg:h-40"
						aria-hidden="true"
						focusable="false"
					/>
				</a>

				<nav aria-label="Główna nawigacja" class="hidden md:block">
					<ul class="flex flex-row gap-4 lg:flex-col lg:gap-5">
						{navLinks.map((link) => {
							const isActive = link.href === currentPath || (link.href === "/" && currentPath === "/");
							return (
								<li>
									<a
										href={link.href}
										class={isActive
											? "text-accent pointer-events-none"
											: "hover:text-accent transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"}
										aria-current={isActive ? "page" : undefined}
									>
										{link.label}
									</a>
								</li>
							);
						})}
					</ul>
				</nav>

				<button
					type="button"
					id="przycisk-menu"
					class="relative h-8 w-8 md:hidden focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
					aria-expanded="false"
					aria-controls="menu-mobilne"
					aria-label="Menu"
				>
					<span aria-hidden="true"></span>
					<span aria-hidden="true"></span>
					<span aria-hidden="true"></span>
				</button>
			</div>
		</Container>

		<!-- Rozwijane menu mobilne. Leży w pasku, więc otwiera się tuż pod nim
		     przy każdej wysokości paska (96 i 60 px). "md:hidden" zostaje na stałe
		     w klasach — nawet gdyby JS nie zdążył zamknąć menu przy zmianie szerokości
		     okna, na większym ekranie i tak się nie pokaże. -->
		<div id="menu-mobilne" class="hidden md:hidden border-b border-line bg-paper">
			<nav aria-label="Nawigacja mobilna">
				<Container>
					<ul class="flex flex-col py-2">
						{navLinks.map((link) => {
							const isActive = link.href === currentPath || (link.href === "/" && currentPath === "/");
							return (
								<li>
									<a
										href={link.href}
										class={`block py-3 hover:text-accent transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper ${isActive ? "text-accent" : ""}`}
										aria-current={isActive ? "page" : undefined}
									>
										{link.label}
									</a>
								</li>
							);
						})}
					</ul>
				</Container>
			</nav>
		</div>
	</div>
</header>

<style>
	#przycisk-menu span {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 20px;
		height: 2px;
		background-color: currentColor;
		transition: transform 0.25s ease, opacity 0.25s ease;
	}

	#przycisk-menu span:nth-child(1) {
		transform: translate(-50%, -50%) translateY(-6px);
	}
	#przycisk-menu span:nth-child(2) {
		transform: translate(-50%, -50%);
	}
	#przycisk-menu span:nth-child(3) {
		transform: translate(-50%, -50%) translateY(6px);
	}

	#przycisk-menu[aria-expanded="true"] span:nth-child(1) {
		transform: translate(-50%, -50%) rotate(45deg);
	}
	#przycisk-menu[aria-expanded="true"] span:nth-child(2) {
		opacity: 0;
	}
	#przycisk-menu[aria-expanded="true"] span:nth-child(3) {
		transform: translate(-50%, -50%) rotate(-45deg);
	}

	@media (prefers-reduced-motion: reduce) {
		#przycisk-menu span {
			transition: none;
		}
	}

	/* Menu mobilne nad treścią (nie przesuwa strony), tuż pod paskiem.
	   +1px: 100% to wysokość paska bez jego dolnej kreski (border-b) — bez tego
	   menu zasłoniłoby kreskę oddzielającą je od paska. */
	#menu-mobilne {
		position: absolute;
		top: calc(100% + 1px);
		left: 0;
		right: 0;
		z-index: 50;
	}
</style>

<script>
	// --- Zwijanie paska przy przewijaniu (telefon i tablet) ---
	// Na samej górze strony pasek ma 96 px i duże logo, po przewinięciu o kilka pikseli
	// zwija się do 60 px (klasy max-lg:group-data-zwiniety:* w znacznikach wyżej).
	// Na komputerze atrybut też się ustawia, ale niczego nie zmienia — tam jest pasek boczny.
	// Przy ograniczonym ruchu (prefers-reduced-motion) rozmiar zmienia się bez animacji (motion-safe:).
	const naglowek = document.getElementById("naglowek");

	if (naglowek) {
		let czekaNaKlatke = false;

		const aktualizujNaglowek = () => {
			naglowek.toggleAttribute("data-zwiniety", window.scrollY > 8);
			czekaNaKlatke = false;
		};

		window.addEventListener(
			"scroll",
			() => {
				if (!czekaNaKlatke) {
					czekaNaKlatke = true;
					requestAnimationFrame(aktualizujNaglowek);
				}
			},
			{ passive: true }
		);

		// Strona otwarta w połowie (odświeżenie, powrót „wstecz”) — od razu właściwy rozmiar.
		aktualizujNaglowek();
	}

	// --- Menu mobilne (hamburger) ---
	const przyciskMenu = document.getElementById("przycisk-menu");
	const menuMobilne = document.getElementById("menu-mobilne");

	if (przyciskMenu && menuMobilne) {
		const otworzMenu = () => {
			przyciskMenu.setAttribute("aria-expanded", "true");
			menuMobilne.classList.remove("hidden");

			// Focus na pierwszym linku w menu
			menuMobilne.querySelector("a")?.focus();

			// Pułapka fokusu od razu (nie w requestAnimationFrame) — inaczej szybkie zamknięcie
			// menu mogłoby zostawić nasłuchiwacz na document na zawsze.
			document.addEventListener("keydown", handleMenuFocusTrap);
		}

		const zamknijMenu = () => {
			// Escape i zmiana szerokości okna wołają tę funkcję zawsze — przy zamkniętym
			// menu nic nie robimy (inaczej Escape w dowolnym miejscu strony kradłby fokus).
			if (przyciskMenu.getAttribute("aria-expanded") !== "true") return;

			przyciskMenu.setAttribute("aria-expanded", "false");
			menuMobilne.classList.add("hidden");

			// Usuń focus trap
			document.removeEventListener("keydown", handleMenuFocusTrap);

			// Fokus zawsze wraca na przycisk hamburgera
			przyciskMenu.focus();
		}

		przyciskMenu.addEventListener("click", () => {
			if (przyciskMenu.getAttribute("aria-expanded") === "true") {
				zamknijMenu();
			} else {
				otworzMenu();
			}
		});

		// Zamknij po kliknięciu w link — inaczej menu zostaje "otwarte" w tle
		// np. po powrocie przyciskiem "wstecz" w przeglądarce.
		menuMobilne.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", zamknijMenu);
		});

		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") zamknijMenu();
		});

		// Gdyby ktoś rozszerzył okno powyżej breakpointu md przy otwartym
		// menu (np. obrót tabletu) — zresetuj stan przycisku i menu.
		window.matchMedia("(min-width: 48rem)").addEventListener("change", (e) => {
			if (e.matches) zamknijMenu();
		});

		// Focus trap dla menu mobilnego: Tab krąży po przycisku menu i wszystkich linkach.
		const handleMenuFocusTrap = (e: KeyboardEvent) => {
			if (e.key !== "Tab") return;

			const elementy = [przyciskMenu, ...menuMobilne.querySelectorAll<HTMLElement>("a")];
			const pierwszy = elementy[0];
			const ostatni = elementy[elementy.length - 1];

			if (e.shiftKey && document.activeElement === pierwszy) {
				// Shift+Tab na pierwszym elemencie – skocz na koniec
				e.preventDefault();
				ostatni.focus();
			} else if (!e.shiftKey && document.activeElement === ostatni) {
				// Tab na ostatnim elemencie – skocz na początek
				e.preventDefault();
				pierwszy.focus();
			}
		}
	}
</script>

---
import Container from "../components/ui/Container.astro";
import { navLinks } from "../data/nav.ts";

const currentPath = Astro.url.pathname;
---

<header
	id="glowny-naglowek"
	class="sticky top-0 z-40 bg-paper text-ink text-xl font-semibold"
>
	<!-- Pasek 60px — overflow-hidden i obcięcie siedzi tutaj (nie na całym
	     <header>), żeby rozwijane menu mobilne poniżej mogło się swobodnie
	     pokazać, zamiast zostać przycięte razem z paskiem. -->
	<div
		id="pasek-naglowka"
		class="h-15 overflow-hidden border-b border-line flex items-center transition-shadow duration-300"
	>
		<div id="tresc-naglowka" class="w-full">
			<Container>
				<div class="flex flex-row items-center justify-between w-full">
					<div class="logo">WB</div>

					<nav aria-label="Główna nawigacja" class="hidden md:block">
						<ul class="flex flex-row gap-4">
							{navLinks.map((link) => {
								const isActive = link.href === currentPath || (link.href === "/" && currentPath === "/");
								return (
									<li>
										<a
											href={link.href}
											class={isActive
												? "text-accent font-medium pointer-events-none"
												: "hover:text-accent transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"}
											aria-current={isActive ? "page" : undefined}
										>
											{link.label}
										</a>
									</li>
								);
							})}
						</ul>
					</nav>

					<button
						type="button"
						id="przycisk-menu"
						class="relative h-8 w-8 md:hidden focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
						aria-expanded="false"
						aria-controls="menu-mobilne"
						aria-label="Otwórz menu"
					>
						<span aria-hidden="true"></span>
						<span aria-hidden="true"></span>
						<span aria-hidden="true"></span>
					</button>
				</div>
			</Container>
		</div>
	</div>

	<!-- Rozwijane menu mobilne. "md:hidden" zostaje na stałe w klasach —
	     nawet gdyby JS nie zdążył zamknąć menu przy zmianie szerokości
	     okna, na desktopie i tak się nie pokaże. -->
	<div id="menu-mobilne" class="hidden md:hidden border-b border-line bg-paper">
		<nav aria-label="Nawigacja mobilna">
			<Container>
				<ul class="flex flex-col py-2">
					{navLinks.map((link) => {
						const isActive = link.href === currentPath || (link.href === "/" && currentPath === "/");
						return (
							<li>
								<a
									href={link.href}
									class={`block py-3 hover:text-accent transition-colors focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper ${isActive ? "text-accent font-medium" : ""}`}
									aria-current={isActive ? "page" : undefined}
								>
									{link.label}
								</a>
							</li>
						);
					})}
				</ul>
			</Container>
		</nav>
	</div>
</header>

<style>
	#przycisk-menu span {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 20px;
		height: 2px;
		background-color: currentColor;
		transition: transform 0.25s ease, opacity 0.25s ease;
	}

	#przycisk-menu span:nth-child(1) {
		transform: translate(-50%, -50%) translateY(-6px);
	}
	#przycisk-menu span:nth-child(2) {
		transform: translate(-50%, -50%);
	}
	#przycisk-menu span:nth-child(3) {
		transform: translate(-50%, -50%) translateY(6px);
	}

	#przycisk-menu[aria-expanded="true"] span:nth-child(1) {
		transform: translate(-50%, -50%) rotate(45deg);
	}
	#przycisk-menu[aria-expanded="true"] span:nth-child(2) {
		opacity: 0;
	}
	#przycisk-menu[aria-expanded="true"] span:nth-child(3) {
		transform: translate(-50%, -50%) rotate(-45deg);
	}

	@media (prefers-reduced-motion: reduce) {
		#przycisk-menu span {
			transition: none;
		}
	}

	/* Mobile menu as overlay - absolute positioning so it doesn't push content/footer */
	#menu-mobilne {
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		z-index: 50;
	}

	a[aria-current="page"] {
		color: var(--color-accent);
		font-weight: 600;
	}
</style>

<script>
	// --- Parallax paska nagłówka (logika 1:1 jak wcześniej — zmienił się
	// tylko element z overflow-hidden/cieniem: pasek zamiast całego <header>). ---
	const pasek = document.getElementById("pasek-naglowka");
	const tresc = document.getElementById("tresc-naglowka");

	const preferujeMniejRuchu = window.matchMedia(
		"(prefers-reduced-motion: reduce)"
	).matches;

	if (pasek && tresc && !preferujeMniejRuchu) {
		let animujeSie = false;

		const aktualizujNaglowek = () => {
			const offset = Math.min(window.scrollY * 0.25, 10);
			tresc.style.transform = `translateY(-${offset}px)`;
			pasek.classList.toggle("shadow-md", window.scrollY > 12);
			animujeSie = false;
		}

		window.addEventListener(
			"scroll",
			() => {
				if (!animujeSie) {
					requestAnimationFrame(aktualizujNaglowek);
					animujeSie = true;
				}
			},
			{ passive: true }
		);
	}

	// --- Menu mobilne (hamburger) ---
	const przyciskMenu = document.getElementById("przycisk-menu");
	const menuMobilne = document.getElementById("menu-mobilne");

	if (przyciskMenu && menuMobilne) {

		const otworzMenu = () => {
	przyciskMenu.setAttribute("aria-expanded", "true");
	przyciskMenu.setAttribute("aria-label", "Zamknij menu");
	menuMobilne.classList.remove("hidden");
	menuMobilne.querySelector("a")?.focus();
	// Pułapka fokusu od razu (nie w requestAnimationFrame) — inaczej szybkie zamknięcie
	// menu mogłoby zostawić nasłuchiwacz na document na zawsze.
	document.addEventListener("keydown", handleMenuFocusTrap);
};

const zamknijMenu = () => {
	// Escape i zmiana szerokości okna wołają tę funkcję zawsze — przy zamkniętym menu nic nie robimy.
	if (przyciskMenu.getAttribute("aria-expanded") !== "true") return;

	przyciskMenu.setAttribute("aria-expanded", "false");
	przyciskMenu.setAttribute("aria-label", "Otwórz menu");
	menuMobilne.classList.add("hidden");
	document.removeEventListener("keydown", handleMenuFocusTrap);
	przyciskMenu.focus(); // fokus zawsze wraca na przycisk
};

		przyciskMenu.addEventListener("click", () => {
			const jestOtwarte = przyciskMenu.getAttribute("aria-expanded") === "true";
			jestOtwarte ? zamknijMenu() : otworzMenu();
		});

		// Zamknij po kliknięciu w link — inaczej menu zostaje "otwarte" w tle
		// np. po powrocie przyciskiem "wstecz" w przeglądarce.
		menuMobilne.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", zamknijMenu);
		});

		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape") zamknijMenu();
		});

		// Gdyby ktoś rozszerzył okno powyżej breakpointu md przy otwartym
		// menu (np. obrót tabletu) — zresetuj stan przycisku i menu.
		window.matchMedia("(min-width: 48rem)").addEventListener("change", (e) => {
			if (e.matches) zamknijMenu();
		});

		// Focus trap handler dla menu mobilnego
		const handleMenuFocusTrap = (e: KeyboardEvent) => {
			if (e.key !== "Tab") return;

			// Tab krąży po przycisku menu i wszystkich linkach, w kolejności jak w DOM.
			const elementy = [przyciskMenu, ...menuMobilne.querySelectorAll<HTMLElement>("a")];
			const pierwszy = elementy[0];
			const ostatni = elementy[elementy.length - 1];

		if (e.shiftKey && document.activeElement === pierwszy) {
			e.preventDefault();
			ostatni.focus();
		} 	
		else if (!e.shiftKey && document.activeElement === ostatni) {
			e.preventDefault();
			pierwszy.focus();
			}
		};
		}
	}
</script>
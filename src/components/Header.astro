---
import Container from "../components/ui/Container.astro";
---

<header
	id="glowny-naglowek"
	class="sticky top-0 z-40 h-15 overflow-hidden flex items-center border-b border-line bg-paper text-ink text-xl font-semibold transition-shadow duration-300"
>
	<div id="tresc-naglowka" class="w-full">
		<Container>
			<div class="flex flex-row items-center justify-between w-full">
				<div class="logo">WB</div>
				<nav aria-label="Główna nawigacja" class="menu">
					<ul class="flex flex-row gap-4">
						<li>
							<a href="/" class="hover:text-accent transition-colors">Homepage</a>
						</li>
						<li>
							<a href="/galeria" class="hover:text-accent transition-colors">Galeria</a>
						</li>
						<li>
							<a href="/o-mnie" class="hover:text-accent transition-colors">
								<span>O mnie</span>
							</a>
						</li>
					</ul>
				</nav>
			</div>
		</Container>
	</div>
</header>

<script>
	// Delikatny "parallax": treść nagłówka porusza się nieco wolniej niż
	// przewijanie strony, a sam pasek dostaje cień po przewinięciu paru pikseli.
	const header = document.getElementById("glowny-naglowek");
	const tresc = document.getElementById("tresc-naglowka");

	const preferujeMniejRuchu = window.matchMedia(
		"(prefers-reduced-motion: reduce)"
	).matches;

	if (header && tresc && !preferujeMniejRuchu) {
		let animujeSie = false;

		function aktualizujNaglowek() {
			const offset = Math.min(window.scrollY * 0.25, 10);
			tresc.style.transform = `translateY(-${offset}px)`;
			header.classList.toggle("shadow-md", window.scrollY > 12);
			animujeSie = false;
		}

		window.addEventListener(
			"scroll",
			() => {
				if (!animujeSie) {
					requestAnimationFrame(aktualizujNaglowek);
					animujeSie = true;
				}
			},
			{ passive: true }
		);
	}
</script>
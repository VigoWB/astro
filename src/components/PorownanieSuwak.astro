---
import type { WersjaLightboxa } from "../lib/galeria.ts";

/**
 * Duże porównanie "przed/po" na pierwszym ekranie strony głównej.
 *
 * Dwa tryby, decyduje o tym build w index.astro (patrz wybierzBohatera):
 * - trybSuwaka=true: linia z uchwytem, którą przeciąga się po zdjęciu — tylko gdy
 *   "przed" i "po" mają identyczny kadr (build to sprawdza).
 * - trybSuwaka=false: zwykły przełącznik "Pokaż przed", jak w lightboksie galerii —
 *   używany, gdy kadry się różnią albo gdy nie ma jeszcze zdjęcia oznaczonego
 *   jako "paraSuwaka" (npm run sync-images -- --wyroznij).
 *
 * Obie wersje ("po" i "przed") to gotowe webp z /_astro/ (te same dane co lightbox
 * w galerii) — bez dodatkowego przetwarzania zdjęcia tutaj.
 *
 * Proporcje pudełka pilnują atrybuty width/height na <img> "po" (przeglądarka sama
 * rezerwuje miejsce, bez przesunięcia layoutu). "przed" leży w tym samym pudełku:
 * w trybie suwaka przez object-cover (ten sam kadr, nie musi mieć identycznych pikseli),
 * w trybie przełącznika przez object-contain (inny kadr widać w całości, bez przycinania).
 *
 * Suwak: widać tylko linię z okrągłym uchwytem. Przeciągać można w dowolnym miejscu
 * zdjęcia (myszą i palcem). Pod spodem nadal jest zwykły <input type="range">, tylko
 * niewidoczny (sr-only) — dzięki niemu działa klawiatura (strzałki) i czytniki ekranu,
 * a fokus z klawiatury widać jako obwódkę na uchwycie.
 */
interface Props {
	po: WersjaLightboxa;
	przed?: WersjaLightboxa;
	opis: string;
	szerokoscOryginalu: number;
	wysokoscOryginalu: number;
	trybSuwaka: boolean;
}

const { po, przed, opis, szerokoscOryginalu, wysokoscOryginalu, trybSuwaka } = Astro.props;
const pokazSuwak = trybSuwaka && Boolean(przed);
const pokazPrzelacznik = !trybSuwaka && Boolean(przed);

// Szerokość porównania NA STRONIE: kolumna Container (max-w-240 = 60rem minus px-4 z obu
// stron = 58rem), węziej 100vw - 2rem. Nie "sizes" z lightboxa — tam limitem jest wysokość ekranu.
const ROZMIAR_NA_STRONIE = "(min-width: 60rem) 58rem, calc(100vw - 2rem)";
---

<div
	class:list={[
		"group relative overflow-hidden rounded-sm bg-cien/5",
		// touch-pan-y touch-pinch-zoom: palcem w poziomie przesuwa się linię, w pionie dalej przewija się strona,
		// a dwoma palcami można powiększyć zdjęcie.
		{ "cursor-ew-resize touch-pan-y touch-pinch-zoom select-none": pokazSuwak },
	]}
	data-porownanie
>
	<!-- "po" zawsze widoczne w tle — LCP, dlatego eager + fetchpriority high. -->
	<img
		src={po.src}
		srcset={po.srcset}
		sizes={ROZMIAR_NA_STRONIE}
		width={szerokoscOryginalu}
		height={wysokoscOryginalu}
		alt={opis || "Zdjęcie po retuszu"}
		loading="eager"
		fetchpriority="high"
		decoding="async"
		draggable="false"
		class="block h-auto w-full select-none"
	/>

	{przed && (
		<img
			src={przed.src}
			srcset={przed.srcset}
			sizes={ROZMIAR_NA_STRONIE}
			width={szerokoscOryginalu}
			height={wysokoscOryginalu}
			alt=""
			aria-hidden="true"
			draggable="false"
			loading="eager"
			class:list={[
				"absolute inset-0 h-full w-full select-none",
				{
					// Suwak: ten sam kadr; połowa odsłonięta już w CSS, zanim zadziała skrypt.
					// Bez animacji clip-path — krawędź idzie równo z linią i palcem.
					"object-cover [clip-path:inset(0_50%_0_0)]": pokazSuwak,
					// Przełącznik: kadr bywa inny — całe "przed", bez przycinania.
					"hidden object-contain bg-paper": !pokazSuwak,
				},
			]}
			data-porownanie-przed
		/>
	)}

	{pokazSuwak && (
		<>
			{/* Niewidoczny, ale działa z klawiatury i dla czytników ekranu. */}
			<input
				type="range"
				min="0"
				max="100"
				value="50"
				step="1"
				class="sr-only"
				aria-label={`Porównaj zdjęcie przed i po retuszu${opis ? `: ${opis}` : ""}`}
				data-porownanie-suwak
			/>
			<span
				class="pointer-events-none absolute left-3 top-3 rounded-full bg-cien/70 px-2.5 py-1 text-xs font-semibold text-paper"
				aria-hidden="true"
			>
				Przed
			</span>
			<span
				class="pointer-events-none absolute right-3 top-3 rounded-full bg-cien/70 px-2.5 py-1 text-xs font-semibold text-paper"
				aria-hidden="true"
			>
				Po
			</span>
			<div
				class="pointer-events-none absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 bg-paper shadow-[0_0_0_1px] shadow-cien/25"
				data-porownanie-linia
				aria-hidden="true"
			>
				{/* Uchwyt na środku linii; obwódka, gdy ukryty suwak ma fokus z klawiatury. */}
				<span class="absolute left-1/2 top-1/2 flex size-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-paper bg-cien/80 text-paper shadow-md group-has-[input:focus-visible]:ring-2 group-has-[input:focus-visible]:ring-accent group-has-[input:focus-visible]:ring-offset-2 group-has-[input:focus-visible]:ring-offset-paper">
					<svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M9 6l-6 6 6 6M15 6l6 6-6 6" />
					</svg>
				</span>
			</div>
		</>
	)}

	{pokazPrzelacznik && (
		<button
			type="button"
			aria-pressed="false"
			data-porownanie-przelacznik
			class="absolute bottom-3 right-3 rounded-full border-2 border-paper/50 bg-cien/70 px-4 py-1.5 text-sm font-semibold text-paper backdrop-blur-sm transition-colors hover:border-paper focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-przycisk focus-visible:ring-offset-2 focus-visible:ring-offset-cien aria-pressed:border-przycisk aria-pressed:bg-przycisk aria-pressed:text-przycisk-tekst"
		>
			Pokaż przed
		</button>
	)}
</div>

<script>
	// Wszystkie porównania na stronie (dziś jest jedno, na pierwszym ekranie).
	document.querySelectorAll<HTMLElement>("[data-porownanie]").forEach((kontener) => {
		const obrazPrzed = kontener.querySelector<HTMLImageElement>("[data-porownanie-przed]");
		const suwak = kontener.querySelector<HTMLInputElement>("[data-porownanie-suwak]");
		const przelacznik = kontener.querySelector<HTMLButtonElement>("[data-porownanie-przelacznik]");
		const linia = kontener.querySelector<HTMLElement>("[data-porownanie-linia]");

		if (suwak && obrazPrzed) {
			// "przed" jest cały czas w DOM, a suwak odsłania go od lewej przez clip-path —
			// dzięki temu obraz "po" w tle (LCP) nigdy nie znika i nie przeskakuje.
			const ustawPozycje = (procent: number) => {
				obrazPrzed.style.clipPath = `inset(0 ${100 - procent}% 0 0)`;
				if (linia) linia.style.left = `${procent}%`;
				// Czytnik ekranu zamiast samej liczby „50” przeczyta, co ona znaczy.
				suwak.setAttribute("aria-valuetext", `${procent}% zdjęcia przed retuszem, ${100 - procent}% po retuszu`);
			};
			ustawPozycje(Number(suwak.value));
			// Klawiatura (strzałki) i czytniki ekranu zmieniają ukryty <input>.
			suwak.addEventListener("input", () => ustawPozycje(Number(suwak.value)));

			// Mysz i palec: linia idzie za kursorem w dowolnym miejscu zdjęcia.
			const ustawZKursora = (e: PointerEvent) => {
				const ramka = kontener.getBoundingClientRect();
				const procent = Math.round(((e.clientX - ramka.left) / ramka.width) * 100);
				suwak.value = String(Math.min(100, Math.max(0, procent)));
				ustawPozycje(Number(suwak.value));
			};
			// Przeciąga jeden wskaźnik naraz (mysz albo pierwszy palec) — drugi palec nic nie zmienia.
			let aktywnyWskaznik: number | null = null;
			let startX = 0;
			let startY = 0;
			// Palcem linia rusza dopiero przy ruchu w poziomie. Ruch w pionie to przewijanie strony:
			// przeglądarka przejmuje gest (pointercancel), a linia zostaje tam, gdzie była.
			let ruchWPoziomie = false;
			const PROG_RUCHU = 8; // px — drobne drgnięcie palca to jeszcze stuknięcie

			kontener.addEventListener("pointerdown", (e) => {
				if (e.button !== 0 || aktywnyWskaznik !== null) return; // tylko lewy przycisk / pierwszy palec
				aktywnyWskaznik = e.pointerId;
				startX = e.clientX;
				startY = e.clientY;
				ruchWPoziomie = e.pointerType === "mouse"; // myszą linia idzie od razu
				kontener.setPointerCapture(e.pointerId);
				if (e.pointerType === "mouse") ustawZKursora(e);
			});
			kontener.addEventListener("pointermove", (e) => {
				if (e.pointerId !== aktywnyWskaznik) return;
				if (!ruchWPoziomie) {
					const dx = Math.abs(e.clientX - startX);
					const dy = Math.abs(e.clientY - startY);
					if (dx < PROG_RUCHU || dx <= dy) return; // jeszcze nie wiadomo albo przewijanie w pionie
					ruchWPoziomie = true;
				}
				ustawZKursora(e);
			});
			kontener.addEventListener("pointerup", (e) => {
				if (e.pointerId !== aktywnyWskaznik) return;
				aktywnyWskaznik = null;
				// Stuknięcie albo koniec przeciągania w poziomie. Ruch w pionie (próba przewijania) linii nie rusza.
				const stukniecie = Math.abs(e.clientX - startX) < PROG_RUCHU && Math.abs(e.clientY - startY) < PROG_RUCHU;
				if (ruchWPoziomie || stukniecie) ustawZKursora(e);
			});
			// Przeglądarka przejęła gest albo wskaźnik zniknął — koniec przeciągania.
			const zakonczPrzeciaganie = (e: PointerEvent) => {
				if (e.pointerId === aktywnyWskaznik) aktywnyWskaznik = null;
			};
			kontener.addEventListener("pointercancel", zakonczPrzeciaganie);
			// Siatka bezpieczeństwa: kontener stracił przechwycenie bez pointerup/pointercancel.
			kontener.addEventListener("lostpointercapture", (e) => {
				if (e.target === kontener) zakonczPrzeciaganie(e);
			});
		}

		if (przelacznik && obrazPrzed) {
			przelacznik.addEventListener("click", () => {
				const pokazujePrzed = przelacznik.getAttribute("aria-pressed") === "true";
				przelacznik.setAttribute("aria-pressed", String(!pokazujePrzed));
				obrazPrzed.classList.toggle("hidden", pokazujePrzed);
			});
		}

		// Blokada prawoklika — ta sama utrudniająca ochrona co w galerii (nie usuwać).
		kontener.addEventListener("contextmenu", (e) => e.preventDefault());
	});
</script>

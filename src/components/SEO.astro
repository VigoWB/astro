---
// Komponent SEO — centralizuje meta tagi, Open Graph, Twitter Cards
// oraz link kanoniczny. Ma trafiać w <head> layoutu.

interface Props {
  title: string;
  description: string;
  /** Ścieżka lub pełny URL do obrazka OG. Domyślnie /og-default.jpg (1200x630). */
  image?: string;
  /** Pełny URL kanoniczny. Jeśli nie podany, wyliczany z Astro.url + Astro.site. */
  canonicalURL?: string;
}

const {
  title,
  description,
  image = "/og-default.jpg",
  canonicalURL,
} = Astro.props;

// Wyliczenie kanonicznego URL-a na podstawie aktualnego adresu, jeśli nie podano ręcznie.
const kanoniczny = canonicalURL
  ? new URL(canonicalURL, Astro.site)
  : new URL(Astro.url.pathname, Astro.site);

// Obrazek OG musi być pełnym, absolutnym URL-em (wymóg specyfikacji OG/Twitter).
const obrazekOG = new URL(image, Astro.site);
---

<!-- Podstawowe meta tagi -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={kanoniczny} />
<meta name="theme-color" content="#eaf4f4" />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={kanoniczny} />
<meta property="og:image" content={obrazekOG} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="pl_PL" />

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={obrazekOG} />

// ============================================
// SECURITY HEADERS dla Cloudflare
// ============================================
const securityHeaders = `
  <meta http-equiv="Content-Security-Policy" content="
    default-src 'self';
    script-src 'self' 'unsafe-inline';
    style-src 'self' 'unsafe-inline';
    img-src 'self' 'data:';
    font-src 'self' 'https://fonts.gstatic.com';
    connect-src 'self' 'https://cloudflare.com';
    frame-src 'none';
    base-uri 'self';
    form-action 'self';
    connection-response 'self';
    upgrade-insecure-requests 'no';
  ">`;

const hstsHeader = `
  <meta http-equiv="Strict-Transport-Security" content="max-age=31536000; includeSubDomains; preload" />`;

const cacheControl = `
  <meta http-equiv="Cache-Control" content="public, private, max-age=31536000" />
  <meta http-equiv="Pragma" content="expires=Thu, 01 Jan 2026 00:00:00 GMT" />
  <meta http-equiv="Expires" content="Mon, 01 Jan 2026 00:00:00 GMT" />
`;

// Wyliczenie kanonicznego URL-a na podstawie aktualnego adresu, jeśli nie podano ręcznie.
`,

<!doctype html>
<html lang="pl">
  <head>
    <!-- ... istniejące meta tagi ... -->
  </head>
---
// Komponent Schema — wstrzykuje dane strukturalne JSON-LD (Schema.org).
// Dane bazowe (osoba, firma, opis galerii) trzymane są w src/data/siteConfig.json,
// żeby nie grzebać w komponencie za każdym razem, gdy coś się zmieni.
//
// Person i ProfessionalService lecą zawsze (są potrzebne na każdej stronie).
// ImageGallery jest opcjonalny — podajesz go tylko na stronie /galeria,
// przekazując listę zdjęć jako prop.
// WebSite zawsze.
// BreadcrumbList opcjonalny (dla stron z nawigacją hierarchiczną).

import siteConfig from "../data/siteConfig.json";
// Zdjęcie profilowe leży w src/assets (trafia do repo, w przeciwieństwie do images/).
// Astro przy buildzie kopiuje je do dist/_astro/ i podaje tu gotowy adres —
// dzięki temu link w danych dla Google zawsze prowadzi do istniejącego pliku.
import zdjecieProfilowe from "../assets/moje-zdjecie.jpg";

interface Zdjecie {
	po: { src: string; width?: number; height?: number };
	opis?: string;
}

interface BreadcrumbItem {
	name: string;
	url: string;
}

interface Props {
	/** Lista zdjęć do wygenerowania schematu ImageGallery. Pomiń, jeśli strona nie ma galerii. */
	zdjecia?: Zdjecie[];
	/** Breadcrumbs dla BreadcrumbList (opcjonalny). */
	breadcrumbs?: BreadcrumbItem[];
}

const { zdjecia, breadcrumbs } = Astro.props;

const bazowyUrl = Astro.site ?? new URL(Astro.url.origin);
const adresZdjeciaProfilowego = new URL(zdjecieProfilowe.src, bazowyUrl).toString();

// --- Person ---
const person = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: siteConfig.person.name,
	alternateName: siteConfig.person.alternateName,
	jobTitle: siteConfig.person.jobTitle,
	email: siteConfig.person.email,
	image: adresZdjeciaProfilowego,
	url: bazowyUrl.toString(),
	sameAs: siteConfig.person.sameAs,
};

// --- ProfessionalService (podtyp LocalBusiness) ---
// Świadomie bez pełnego adresu (ulica/numer) — to portfolio osobiste,
// nie firma ze stacjonarnym lokalem. Samo miasto/kraj wystarczy do Rich Results.
const business = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	name: siteConfig.business.name,
	description: siteConfig.business.description,
	url: bazowyUrl.toString(),
	image: adresZdjeciaProfilowego,
	email: siteConfig.person.email,
	priceRange: siteConfig.business.priceRange,
	address: {
		"@type": "PostalAddress",
		addressLocality: siteConfig.business.addressLocality,
		addressCountry: siteConfig.business.addressCountry,
	},
	sameAs: siteConfig.person.sameAs,
};

// --- WebSite (zawsze) ---
// Bez SearchAction: galeria nie ma wyszukiwarki, a Google i tak wycofał
// pole wyszukiwania w wynikach (listopad 2024).
const website = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: siteConfig.business.name,
	url: bazowyUrl.toString(),
};

// --- ImageGallery (tylko jeśli przekazano zdjęcia) ---
const gallery = zdjecia?.length
	? {
			"@context": "https://schema.org",
			"@type": "ImageGallery",
			name: siteConfig.gallery.name,
			description: siteConfig.gallery.description,
			url: new URL("/galeria", bazowyUrl).toString(),
			image: zdjecia.map((z) => ({
				"@type": "ImageObject",
				contentUrl: new URL(z.po.src, bazowyUrl).toString(),
				...(z.opis ? { name: z.opis } : {}),
				...(z.po.width ? { width: z.po.width } : {}),
				...(z.po.height ? { height: z.po.height } : {}),
			})),
		}
	: null;

// --- BreadcrumbList (tylko jeśli przekazano breadcrumbs) ---
const breadcrumbList = breadcrumbs?.length
	? {
			"@context": "https://schema.org",
			"@type": "BreadcrumbList",
			itemListElement: breadcrumbs.map((item, index) => ({
				"@type": "ListItem",
				position: index + 1,
				name: item.name,
				item: item.url,
			})),
		}
	: null;
---

<script type="application/ld+json" set:html={JSON.stringify(person)} />
<script type="application/ld+json" set:html={JSON.stringify(business)} />
<script type="application/ld+json" set:html={JSON.stringify(website)} />
{gallery && <script type="application/ld+json" set:html={JSON.stringify(gallery)} />}
{breadcrumbList && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbList)} />}
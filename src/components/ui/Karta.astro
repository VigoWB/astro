---
import { Image } from 'astro:assets';
const { po, przed, opis } = Astro.props;
---
<button
	type="button"
	class="group text-left bg-white border border-neutral-300 p-4 flex flex-col gap-2 cursor-zoom-in"
	data-gallery-item
	data-po={po.src}
	data-przed={przed?.src ?? ""}
	data-opis={opis}
>
	<div class="max-h-60 overflow-hidden">
		<Image
			src={po}
			height="300"
			width="450"
			alt={opis}
			class="w-full h-full object-cover transition-transform group-hover:scale-105"
		/>
	</div>
	<div class="text-center font-bold my-2">
		<span>{opis}</span>
	</div>
</button>
---
import { Image } from 'astro:assets';
const { po, przed, opis } = Astro.props;
---
<button
	type="button"
	class="group mb-6 block w-full break-inside-avoid text-left bg-white border border-neutral-300 p-4 cursor-zoom-in"
	data-gallery-item
	data-po={po.src}
	data-przed={przed?.src ?? ""}
	data-opis={opis}
>
	<Image
		src={po}
		width={600}
		alt={opis}
		class="w-full h-auto object-cover transition-transform group-hover:scale-105"
	/>
	<div class="text-center font-bold mt-2">
		<span>{opis}</span>
	</div>
</button>
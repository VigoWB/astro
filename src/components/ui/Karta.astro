---
import { Image } from 'astro:assets';
import type { ExifZdjecia, WersjaLightboxa } from '../../lib/galeria.ts';

interface Props {
	/** Oryginał z R2 — źródło miniatury. */
	po: { src: string; width: number; height: number };
	/** Wersje do lightboxa: "po" zawsze, "przed" tylko gdy istnieje. */
	lightbox: { po: WersjaLightboxa; przed?: WersjaLightboxa };
	opis?: string;
	kategoria?: string[];
	exif?: Partial<ExifZdjecia>;
	priority?: boolean;
	/** Karta poza pierwszą porcją zdjęć — startuje ukryta, pokaże ją przycisk "Załaduj więcej". */
	ukryta?: boolean;
}

const { po, lightbox, opis = "", kategoria = [], exif = {}, priority = false, ukryta = false } = Astro.props;

// Miniatura w kaflu galerii ma 600 px szerokości. Wysokość liczymy z prawdziwych
// proporcji zdjęcia — dzięki temu miniatura nie jest przycinana.
const SZEROKOSC_MINIATURY = 600;
const wysokoscMiniatury = Math.round((SZEROKOSC_MINIATURY * po.height) / po.width);

// Krótki podpis z danych aparatu, np. "ISO 100 • f/2.8 • 50mm • 1/200s".
	// Składamy go już podczas budowania strony — lightbox dostaje gotowy tekst.
	function formatujExif(dane: Props["exif"]): string {
		if (!dane) return "";
		const czesci: string[] = [];
		if (dane.iso) czesci.push(`ISO ${dane.iso}`);
		if (dane.przyslona) czesci.push(`f/${Number(dane.przyslona.toFixed(1))}`);
		if (dane.ogniskowa) czesci.push(`${Math.round(dane.ogniskowa)}mm`);
		if (dane.czasNaswietlania) {
			const t = dane.czasNaswietlania;
			// Od 0,3 s dziesiętnie (0.4s, 0.8s, 1.3s), jak w aparacie i Lightroomie.
			czesci.push(t < 0.3 ? `1/${Math.round(1 / t)}s` : `${Number(t.toFixed(1))}s`);
		}
		return czesci.join(" • ");
	}
---
<button
	type="button"
	class:list={[
		"group mb-6 block w-full break-inside-avoid text-left rounded-sm cursor-zoom-in motion-safe:transition-[opacity,translate] motion-safe:duration-500 motion-safe:ease-out focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper border border-ink/10",
		// Pierwsza karta (priority = LCP) bez animacji wejścia — widoczna od razu, bez czekania na skrypt.
		{ hidden: ukryta, "opacity-0 translate-y-6": !priority },
	]}
	data-gallery-item
	data-po={lightbox.po.src}
	data-po-srcset={lightbox.po.srcset}
	data-po-sizes={lightbox.po.sizes}
	data-przed={lightbox.przed?.src ?? ""}
	data-przed-srcset={lightbox.przed?.srcset ?? ""}
	data-przed-sizes={lightbox.przed?.sizes ?? ""}
	data-opis={opis}
	data-kategoria={JSON.stringify(kategoria)}
	data-exif={formatujExif(exif)}
	data-testid="gallery-item"
>
	<div class="relative overflow-hidden bg-ink/5 group-hover:bg-ink/20 transition-colors duration-300">
		<Image
			src={po.src}
			width={SZEROKOSC_MINIATURY}
			height={wysokoscMiniatury}
			alt={opis || "Zdjęcie z portfolio fotograficznego Wiktora"}
			loading={priority ? "eager" : "lazy"}
			fetchpriority={priority ? "high" : undefined}
			decoding="async"
			draggable="false"
			data-miniatura
			class:list={[
				"w-full h-auto object-cover motion-safe:transition-all motion-safe:duration-300 group-hover:scale-105",
				// Efekt "wyostrzenia" przy wczytaniu — tylko dla miniatur ładowanych leniwie.
				// Pierwsze zdjęcie (priority) jest widoczne od razu, żeby nie opóźniać LCP.
				// Klasy zdejmuje skrypt w Galeria.astro, gdy obrazek się wczyta.
				{ "opacity-0 blur-md scale-105": !priority },
			]}
		/>
		<!-- Podpis po najechaniu myszką — tylko dla oka (aria-hidden). Czytnik ekranu
		     dostaje opis z alt obrazka, więc bez tego przeczytałby go dwa razy. -->
		<div class="absolute inset-0 bg-ink/0 group-hover:bg-ink/40 transition-colors duration-300 flex items-end p-3" aria-hidden="true">
			<div class="w-full text-center text-paper text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-300">
				{opis}
			</div>
		</div>
	</div>
</button>

---
import { Image } from 'astro:assets';
const { po, przed, opis, kategoria = [], priority = false } = Astro.props;
---
<button
	type="button"
	class="group mb-6 block w-full break-inside-avoid text-left bg-card border-2 border-ink/30 p-4 cursor-zoom-in opacity-0 translate-y-6 transition-all duration-500 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
	data-gallery-item
	data-reveal
	data-po={po.src}
	data-przed={przed?.src ?? ""}
	data-opis={opis}
	data-kategoria={kategoria.join(" ")}
>
	<div class="overflow-hidden bg-line">
		<Image
			src={po}
			width={600}
			alt={opis || "Zdjęcie z portfolio fotograficznego Wiktora"}
			loading={priority ? "eager" : "lazy"}
			fetchpriority={priority ? "high" : undefined}
			decoding="async"
			class="w-full h-auto object-cover scale-105 opacity-0 blur-md transition-all duration-700 ease-out group-hover:scale-105"
			onload="this.classList.remove('opacity-0','blur-md','scale-105')"
		/>
	</div>
	<div class="text-center font-bold mt-2 text-ink">
		<span>{opis}</span>
	</div>
</button>
---
import { Image } from 'astro:assets';

interface Props {
	po: { src: string; width: number; height: number };
	przed?: { src: string };
	opis?: string;
	kategoria?: string[];
	exif?: {
		iso?: number | null;
		przyslona?: number | null;
		ogniskowa?: number | null;
		czasNaswietlania?: number | null;
		make?: string | null;
		model?: string | null;
		lensModel?: string | null;
	};
	priority?: boolean;
	/** Karta poza pierwszą porcją zdjęć — startuje ukryta, pokaże ją przycisk "Załaduj więcej". */
	ukryta?: boolean;
}

const { po, przed, opis = "", kategoria = [], exif, priority = false, ukryta = false } = Astro.props;

// Miniatura w kaflu galerii ma 600 px szerokości. Wysokość liczymy z prawdziwych
// proporcji zdjęcia — dzięki temu miniatura nie jest przycinana.
const SZEROKOSC_MINIATURY = 600;
const wysokoscMiniatury = Math.round((SZEROKOSC_MINIATURY * po.height) / po.width);

// Krótki podpis z danych aparatu, np. "ISO 100 • f/2.8 • 50mm • 1/200s".
	// Składamy go już podczas budowania strony — lightbox dostaje gotowy tekst.
	function formatujExif(dane: Props["exif"]): string {
		if (!dane) return "";
		const czesci: string[] = [];
		if (dane.iso) czesci.push(`ISO ${dane.iso}`);
		if (dane.przyslona) czesci.push(`f/${Number(dane.przyslona.toFixed(1))}`);
		if (dane.ogniskowa) czesci.push(`${Math.round(dane.ogniskowa)}mm`);
		if (dane.czasNaswietlania) {
			const t = dane.czasNaswietlania;
			czesci.push(t < 1 ? `1/${Math.round(1 / t)}s` : `${t}s`);
		}
		return czesci.join(" • ");
	}
---
<button
	type="button"
	class:list={[
		"group mb-6 block w-full break-inside-avoid text-left rounded-sm cursor-zoom-in opacity-0 translate-y-6 transition-all duration-500 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper border border-ink/10",
		{ hidden: ukryta },
	]}
	data-gallery-item
	data-reveal
	data-po={po.src}
	data-przed={przed?.src ?? ""}
	data-opis={opis}
	data-kategoria={kategoria.join(" ")}
	data-exif={formatujExif(exif)}
	data-testid="gallery-item"
>
	<div class="relative overflow-hidden bg-black/5 group-hover:bg-black/20 transition-colors duration-300">
		<Image
			src={po.src}
			width={SZEROKOSC_MINIATURY}
			height={wysokoscMiniatury}
			alt={opis || "Zdjęcie z portfolio fotograficznego Wiktora"}
			loading={priority ? "eager" : "lazy"}
			fetchpriority={priority ? "high" : undefined}
			decoding="async"
			draggable="false"
			class="w-full h-auto object-cover transition-transform duration-300 group-hover:scale-105"
			onload="this.classList.remove('opacity-0','blur-md','scale-105')"
		/>
		<!-- Overlay with description on hover -->
		<div class="absolute inset-0 bg-black/0 group-hover:bg-black/40 transition-colors duration-300 flex items-end p-3">
			<div class="w-full text-center text-white text-sm font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-300">
				{opis}
			</div>
		</div>
	</div>
</button>

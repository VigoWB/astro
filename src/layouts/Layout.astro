---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/ui/Container.astro";
import SEO from "../components/SEO.astro";
import Schema from "../components/Schema.astro";

const { title, frontmatter, description, image, canonicalURL, zdjecia } = Astro.props;
const pageTitle = title ?? frontmatter?.title ?? "Wiktor — Fotografia";
const pageDescription = description ?? frontmatter?.description ?? "Portfolio fotograficzne Wiktora.";
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<SEO title={pageTitle} description={pageDescription} image={image} canonicalURL={canonicalURL} />
		<Schema zdjecia={zdjecia} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="flex flex-col min-h-dvh">
		<Header/>
		<main class="wrapper flex-1 w-full">
			<Container>
				<slot />
			</Container>
		</main>
		<Footer/>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/ui/Container.astro";
import SEO from "../components/SEO.astro";
import Schema from "../components/Schema.astro";

const { title, frontmatter, description, image, canonicalURL, zdjecia, breadcrumbs } = Astro.props;
const pageTitle = title ?? frontmatter?.title ?? "Wiktor — Fotografia";
const pageDescription = description ?? frontmatter?.description ?? "Portfolio fotograficzne Wiktora.";

// Cloudflare Web Analytics - opcjonalny, konfiguracja przez .env
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<SEO title={pageTitle} description={pageDescription} image={image} canonicalURL={canonicalURL} />
		<Schema zdjecia={zdjecia} breadcrumbs={breadcrumbs} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="apple-touch-icon" href="/icon-192.png" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="Wiktor Foto" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap"
			rel="stylesheet"
		/>
		<!-- Preload OG image for better LCP/SEO -->
		<link rel="preload" as="image" href="/og-default.jpg" fetchpriority="high" />
		{cfBeaconToken && (
			<script
				defer
				data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
				src="https://static.cloudflareinsights.com/beacon.min.js"
			></script>
		)}
		<script>
			// Rejestracja Service Workera (generowanego przez `workbox generateSW`
			// jako krok po `astro build` -- zob. package.json i workbox-config.cjs).
			// Cicho zawodzi w dev (plik nie istnieje poza buildem produkcyjnym).
			if ("serviceWorker" in navigator) {
				window.addEventListener("load", () => {
					navigator.serviceWorker.register("/sw.js", { scope: "/" }).catch(() => {});
				});
			}
		</script>
	</head>
	<body class="flex flex-col min-h-dvh">
		<Header/>
		<main class="wrapper flex-1 w-full">
			<Container>
				<slot />
			</Container>
		</main>
		<Footer/>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
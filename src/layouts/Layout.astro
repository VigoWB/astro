---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Container from "../components/ui/Container.astro";
import SEO from "../components/SEO.astro";
import Schema from "../components/Schema.astro";

const { title, frontmatter, description, image, canonicalURL, zdjecia, breadcrumbs, turnstile } = Astro.props;
const pageTitle = title ?? frontmatter?.title ?? "Wiktor — Fotografia";
const pageDescription = description ?? frontmatter?.description ?? "Portfolio fotograficzne Wiktora.";

// Cloudflare Web Analytics - opcjonalny, konfiguracja przez .env
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		{/* Wczytanie z wyprzedzeniem — oba pliki są małe (razem ok. 40 KB) i potrzebne
		    na każdej stronie, więc ograniczamy migotanie/przesunięcie tekstu (CLS)
		    przy podmianie na docelowy font. Roadmapa: "Lżejsza czcionka". */}
		<link rel="preload" href="/fonts/noto-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/noto-sans-polskie-znaki.woff2" as="font" type="font/woff2" crossorigin />
		<SEO title={pageTitle} description={pageDescription} image={image} canonicalURL={canonicalURL} />
		<Schema zdjecia={zdjecia} breadcrumbs={breadcrumbs} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="apple-touch-icon" href="/icon-192.png" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="Wiktor Foto" />
		<meta name="generator" content={Astro.generator} />
		{turnstile && (
			<>
				{/* Cloudflare Turnstile — ochrona formularza kontaktowego przed botami, patrz ContactForm.astro */}
				<link rel="preconnect" href="https://challenges.cloudflare.com" />
				<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
			</>
		)}
		{cfBeaconToken && (
			<script
				defer
				data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
				src="https://static.cloudflareinsights.com/beacon.min.js"
			></script>
		)}
		<script>
			if ("serviceWorker" in navigator) {
				window.addEventListener("load", () => {
					navigator.serviceWorker.register("/sw.js", { scope: "/" }).catch(() => {});
				});
			}
		</script>
	</head>
	<body class="flex flex-col min-h-dvh">
		
			<a href="#glowna-tresc"
			class="sr-only focus-visible:not-sr-only focus-visible:fixed focus-visible:top-2 focus-visible:left-2 focus-visible:z-50 focus-visible:rounded-md focus-visible:bg-paper focus-visible:px-4 focus-visible:py-2 focus-visible:font-medium focus-visible:text-ink focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
		>
			Przejdź do treści
		</a>
		<Header/>
		<main id="glowna-tresc" tabindex="-1" class="wrapper flex-1 w-full focus:outline-hidden">
			<Container>
				<slot />
			</Container>
		</main>
		<Footer/>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>
---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Nie znaleziono strony" description="Strona nie została znaleziona. Powrót do strony głównej.">
	<div class="py-12 text-center">
		<h1 class="text-6xl font-bold text-ink">404</h1>
		<p class="mt-4 text-xl text-muted">Nie znaleziono strony</p>
		<p class="mt-2 text-muted">Przepraszamy, ale szukana strona nie istnieje.</p>
		<a href="/" class="inline-flex items-center gap-2 mt-6 underline text-ink hover:text-accent transition-colors">
			<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
			Wróć na stronę główną
		</a>
	</div>
</Layout>
---
import Layout from "../layouts/Layout.astro";
import Galeria from "../components/Galeria.astro";
import { kategorie } from "../data/kategorie.ts";

// Podpisy zdjęć — klucz to nazwa pliku "po". Zdjęcie bez wpisu tutaj
// po prostu nie będzie miało widocznego podpisu (build się nie wywali).
// Atrybut alt ma jednak osobny, opisowy fallback w Karta.astro i w skrypcie
// lightboxa w Galeria.astro, więc żadne zdjęcie nie zostaje bez tekstu
// alternatywnego dla czytników ekranu.
const opisy: Record<string, { opis: string; kategoria: string[] }> = {
	"DSC_1111.jpg": { opis: "Zielony", kategoria: ["Portrety"] },
	"DSC_1112.jpg": { opis: "Zielony2?", kategoria: ["Portrety", "Pracownia"] },
	"DSC_1113.jpg": { opis: "Fiolet", kategoria: ["Portrety"] },
	"DSC_1114.jpg": { opis: "Zielony kfadrat", kategoria: ["Pracownia"] },
	"DSC_1115.jpg": { opis: "Zielony? kfadrat", kategoria: ["Pracownia"] },
	"DSC_1116.jpg": { opis: "Fioletowy kfadrat", kategoria: ["Pracownia"] },
	"DSC_4968-Edytuj.jpg": { opis: "Ja i koticzek", kategoria: ["Portrety", "Przyroda"] },
	"DSC_4971-Edytuj.jpg": { opis: "Milli bobby brałn", kategoria: ["Portrety"] },
	"DSC_4975-Edytuj.jpg": { opis: "Stranger things", kategoria: ["Pracownia"] },
};

// Wciąga wszystkie zdjęcia "po" (bez przedrostka przed_) z folderu images/
const poModules = import.meta.glob<{ default: ImageMetadata }>(
	"../../images/DSC_*.jpg",
	{ eager: true }
);

// Wciąga wszystkie zdjęcia "przed"
const przedModules = import.meta.glob<{ default: ImageMetadata }>(
	"../../images/przed_DSC_*.jpg",
	{ eager: true }
);

const zdjecia = Object.entries(poModules).map(([sciezka, modul]) => {
	const nazwaPliku = sciezka.split("/").pop()!;
	const sciezkaPrzed = sciezka.replace(nazwaPliku, `przed_${nazwaPliku}`);

	return {
		po: modul.default,
		przed: przedModules[sciezkaPrzed]?.default,
		opis: opisy[nazwaPliku]?.opis ?? "",
		kategoria: opisy[nazwaPliku]?.kategoria ?? [],
	};
});
---

<Layout title="Galeria — Wiktor" zdjecia={zdjecia}>
	<h1 class="text-3xl text-ink font-bold text-indigo-800/60 py-8">Galeria</h1>
	<Galeria zdjecia={zdjecia} kategorie={kategorie} />
</Layout>
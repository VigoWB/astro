---
import Layout from "../layouts/Layout.astro";
import Galeria from "../components/Galeria.astro";
import { kategorie } from "../data/kategorie.ts";
import { wczytajZdjecia, zdjeciaDlaGoogle } from "../lib/galeria.ts";

// Lista zdjęć (nazwa, opis, kategorie, wymiary, dane z aparatu) pochodzi z pliku
// src/data/galeria.json. Ten plik generuje skrypt `npm run sync-images` —
// nie edytuj go ręcznie. Same zdjęcia leżą w Cloudflare R2.
//
// Wczytywanie i przygotowanie zdjęć (adresy, wersje do lightboxa) jest wspólne
// ze stroną główną — patrz src/lib/galeria.ts.
const zdjecia = await wczytajZdjecia();
---

<Layout
	title="Galeria — Wiktor"
	description="Zdjęcia produktowe z podglądem przed i po retuszu — zobacz, jak zmieniają się kadr, tło i kolory po obróbce. Kliknij zdjęcie, żeby je powiększyć."
	zdjecia={zdjeciaDlaGoogle(zdjecia)}
	breadcrumbs={[{ name: "Strona główna", url: "/" }, { name: "Galeria", url: "/galeria/" }]}
>
	<h1 class="text-3xl font-bold text-ink py-8">Galeria</h1>
	<Galeria zdjecia={zdjecia} kategorie={kategorie} />
</Layout>
---
import Layout from "../layouts/Layout.astro";
import Galeria from "../components/Galeria.astro";
import PorownanieSuwak from "../components/PorownanieSuwak.astro";
import { kategorie } from "../data/kategorie.ts";
import { wczytajZdjecia, type Zdjecie } from "../lib/galeria.ts";

// Strona główna — wizytówka retuszu produktowego:
// (1) suwak przed/po z jedną mocną parą, (2) co poprawiam przy retuszu,
// (3) kilka wybranych par (kliknięcie otwiera lightbox jak w galerii),
// (4) jak zamówić retusz (kroki), (5) zaproszenie do kontaktu.
const zdjecia = await wczytajZdjecia();

// --- (1) Para do suwaka ---
// Suwak wymaga identycznego kadru "przed" i "po". Dopóki Wiktor takiej pary nie oznaczy
// (npm run sync-images -- --wyroznij), strona i tak działa: pokazuje zastępcze
// zdjęcie ze zwykłym przełącznikiem "Pokaż przed", zamiast przerywać build.
const TOLERANCJA_PROPORCJI = 0.02;

function proporcjeZgodne(zdjecie: Zdjecie): boolean {
	if (!zdjecie.lightbox.przed) return false;
	const proporcjaPo = zdjecie.po.width / zdjecie.po.height;
	const proporcjaPrzed = zdjecie.lightbox.przed.szerokosc / zdjecie.lightbox.przed.wysokosc;
	return Math.abs(proporcjaPo - proporcjaPrzed) / proporcjaPo <= TOLERANCJA_PROPORCJI;
}

function wybierzBohatera(lista: Zdjecie[]): { zdjecie: Zdjecie; trybSuwaka: boolean } | null {
	if (lista.length === 0) return null;

	const oznaczone = lista.filter((z) => z.paraSuwaka);
	if (oznaczone.length > 1) {
		console.warn(
			`index: ${oznaczone.length} zdjęć oznaczonych jako "paraSuwaka" w galeria.json — użyto pierwszego (npm run sync-images -- --wyroznij, żeby zostawić tylko jedno).`
		);
	}

	const kandydat = oznaczone[0];
	if (!kandydat) {
		const zastepcze = lista.find((z) => z.wyroznione) ?? lista[0];
		console.warn(
			'index: brak zdjęcia oznaczonego jako "paraSuwaka" w galeria.json — na pierwszym ekranie pokazano zastępcze zdjęcie z przełącznikiem "Pokaż przed" zamiast suwaka (npm run sync-images -- --wyroznij, żeby je ustawić).'
		);
		return { zdjecie: zastepcze, trybSuwaka: false };
	}

	if (!proporcjeZgodne(kandydat)) {
		console.warn(
			`index: zdjęcie oznaczone jako "paraSuwaka" (${kandydat.opis || kandydat.po.src}) ma inne proporcje "przed" i "po" — pokazano przełącznik zamiast suwaka. Przygotuj parę w identycznym kadrze.`
		);
		return { zdjecie: kandydat, trybSuwaka: false };
	}

	return { zdjecie: kandydat, trybSuwaka: true };
}

const bohater = wybierzBohatera(zdjecia);

// --- (3) Wybrane prace niżej na stronie ---
const LIMIT_WYROZNIONYCH = 6;

function wybierzWyroznione(lista: Zdjecie[], pominiete?: Zdjecie): Zdjecie[] {
	let wynik = lista.filter((z) => z.wyroznione && z !== pominiete);
	if (wynik.length === 0) {
		console.warn(
			'index: żadne zdjęcie nie ma ustawionego "wyroznione" w galeria.json — tymczasowo pokazano pierwsze zdjęcia z galerii (npm run sync-images -- --wyroznij, żeby wybrać właściwe).'
		);
		wynik = lista.filter((z) => z !== pominiete);
	}
	return wynik.slice(0, LIMIT_WYROZNIONYCH);
}

const wybranePrace = wybierzWyroznione(zdjecia, bohater?.zdjecie);

// Treść tymczasowa (placeholder) — do potwierdzenia przez Wiktora.
const PUNKTY_RETUSZU = [
	"Usuwam kurz i rysy",
	"Równe, czyste białe tło pod sklep internetowy",
	"Wierne kolory produktu",
	"Usuwam odblaski na szkle i metalu",
];

// --- (4) Jak zamówić retusz ---
// Kroki muszą zgadzać się z najczęstszymi pytaniami na /kontakt/ (NajczestszePytania.astro):
// przesyłanie plików, bezpłatna wycena, termin, format plików i zasady poprawek.
const KROKI_ZAMOWIENIA = [
	{
		tytul: "Wiadomość i pliki",
		opis: "Napisz przez formularz, co to za produkty i ile mniej więcej masz zdjęć. Pliki wyślij przez SwissTransfer albo Dysk Google i wklej link do wiadomości.",
	},
	{
		tytul: "Wycena i termin",
		opis: "Odpiszę z ceną i terminem. Wycena jest bezpłatna i do niczego nie zobowiązuje.",
	},
	{
		tytul: "Retusz",
		opis: "Trwa zwykle 5–7 dni roboczych od zaakceptowania wyceny.",
	},
	{
		tytul: "Odbiór i poprawki",
		opis: "Gotowe zdjęcia dostaniesz jako JPG w pełnej rozdzielczości, linkiem przez SwissTransfer. Jeśli coś Ci nie pasuje, w ciągu 7 dni wypisz wszystkie uwagi w jednej wiadomości. Bez dopłaty poprawię do 25% zdjęć z zamówienia.",
	},
];
---

<Layout
	title="Retusz i fotografia produktowa Poznań — Wiktor"
	description="Fotografia i retusz produktowy w Poznaniu: czyste ujęcia, równe białe tło i wierne kolory do sklepu internetowego. Zobacz przykłady przed i po retuszu."
	breadcrumbs={[{ name: "Strona główna", url: "/" }]}
>
	<div class="space-y-16 py-12">
		<!-- (1) Pierwszy ekran -->
		<section class="space-y-6">
			<h1 class="max-w-prose text-3xl font-bold text-ink">Fotografia i retusz produktowy · Poznań</h1>

			{bohater ? (
				<>
					<PorownanieSuwak
						po={bohater.zdjecie.lightbox.po}
						przed={bohater.zdjecie.lightbox.przed}
						opis={bohater.zdjecie.opis}
						szerokoscOryginalu={bohater.zdjecie.po.width}
						wysokoscOryginalu={bohater.zdjecie.po.height}
						trybSuwaka={bohater.trybSuwaka}
					/>
					<div class="flex flex-wrap gap-4">
						<a
							href="/galeria/"
							class="rounded-full bg-przycisk px-6 py-3 font-semibold text-przycisk-tekst transition-colors hover:bg-przycisk-hover focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
						>
							Zobacz galerię
						</a>
						<a
							href="/kontakt/"
							class="rounded-full border-2 border-ink/30 px-6 py-3 font-semibold text-ink transition-colors hover:border-accent hover:text-accent focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper"
						>
							Napisz do mnie
						</a>
					</div>
				</>
			) : (
				<p class="max-w-prose text-muted">Galeria jest jeszcze pusta — pierwsze zdjęcia pojawią się tu wkrótce.</p>
			)}
		</section>

		<!-- (2) Co poprawiam przy retuszu -->
		<section aria-labelledby="retusz-naglowek" class="space-y-4 rounded-xl bg-blok p-6 sm:p-8">
			<h2 id="retusz-naglowek" class="text-2xl font-bold text-paper">Co poprawiam przy retuszu</h2>
			<ul class="grid gap-3 sm:grid-cols-2">
				{PUNKTY_RETUSZU.map((punkt) => (
					<li class="flex items-start gap-2 text-blok-tekst">
						<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-przycisk" aria-hidden="true"></span>
						{punkt}
					</li>
				))}
			</ul>
		</section>

		<!-- (3) Wybrane prace -->
		{wybranePrace.length > 0 && (
			<section aria-labelledby="wybrane-naglowek" class="space-y-4">
				<h2 id="wybrane-naglowek" class="text-2xl font-bold text-ink">Wybrane prace</h2>
				<Galeria zdjecia={wybranePrace} kategorie={kategorie} pokazFiltry={false} pokazZaladujWiecej={false} priorytetPierwszego={false} />
			</section>
		)}

		<!-- (4) Jak zamówić retusz -->
		<section aria-labelledby="zamowienie-naglowek" class="space-y-4">
			<h2 id="zamowienie-naglowek" class="text-2xl font-bold text-ink">Jak zamówić retusz</h2>
			<ol class="grid gap-6 sm:grid-cols-2">
				{KROKI_ZAMOWIENIA.map((krok, indeks) => (
					<li class="flex items-start gap-4">
						<span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-przycisk font-semibold text-przycisk-tekst">
							{indeks + 1}
						</span>
						<div class="space-y-1">
							<h3 class="font-semibold text-ink">{krok.tytul}</h3>
							<p class="text-muted">{krok.opis}</p>
						</div>
					</li>
				))}
			</ol>
		</section>

		<!-- (5) Zaproszenie do kontaktu -->
		<section class="space-y-4 rounded-xl bg-blok p-6 text-center sm:p-8">
			<h2 class="text-2xl font-bold text-paper">Masz zdjęcia do obrobienia?</h2>
			<p class="mx-auto max-w-prose text-blok-tekst">
				Napisz, jakie zdjęcia potrzebujesz obrobić — odpiszę z wyceną i terminem.
			</p>
			<a
				href="/kontakt/"
				class="inline-block rounded-full bg-przycisk px-6 py-3 font-semibold text-przycisk-tekst transition-colors hover:bg-przycisk-hover focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-przycisk focus-visible:ring-offset-2 focus-visible:ring-offset-blok"
			>
				Napisz do mnie
			</a>
		</section>
	</div>
</Layout>
